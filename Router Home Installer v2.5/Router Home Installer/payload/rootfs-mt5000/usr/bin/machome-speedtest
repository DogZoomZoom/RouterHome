#!/usr/bin/lua
-- machome-speedtest: runs Ookla Speedtest CLI on the WAN or on each connected WireGuard / OpenVPN tunnel, one at a time.
-- Started by /etc/init.d/machome-st (procd). Mode is read from /tmp/machome/speedtest.req ("wan", "vpn", "all",
-- or "vpn:<tunnel>" for one tunnel).
-- Live state: /tmp/machome/speedtest.json   Last results: /etc/machome/speedtest-last.json

local cjson = require "cjson"
local DIR = "/tmp/machome"
local STATE = DIR .. "/speedtest.json"
local LAST = "/etc/machome/speedtest-last.json"
local LOCK = DIR .. "/speedtest.lock"
local CANCEL = DIR .. "/speedtest.cancel"
local BIN = "/usr/share/machome/speedtest"

local function readf(p) local f = io.open(p, "r"); if not f then return nil end; local s = f:read("*a"); f:close(); return s end
local function writef(p, s) local t = p .. ".tmp"; local f = io.open(t, "w"); if not f then return end; f:write(s); f:close(); os.rename(t, p) end
local function trim(s) return s and (s:gsub("^%s+", ""):gsub("%s+$", "")) or "" end
local function sh(c) local p = io.popen(c .. " 2>/dev/null"); if not p then return "" end; local s = p:read("*a") or ""; p:close(); return s end
local function exists(p) local f = io.open(p, "r"); if f then f:close(); return true end; return false end

os.execute("mkdir -p " .. DIR .. " /etc/machome")
local mode = trim(readf(DIR .. "/speedtest.req") or arg[1] or "")
-- "vpn:<tunnel>" = test just that one tunnel (VPN chooser on the Speed Test card, 2026-11-17)
local only = mode:match("^vpn:((%a+)client%d+)$")
if only and not (only:match("^wgclient%d+$") or only:match("^ovpnclient%d+$")) then only = nil end
if mode:match("^vpn:") and not only then only = "-" end   -- unknown tunnel name: test nothing (never fall back to all)
if only then mode = "vpn" end
if mode ~= "wan" and mode ~= "vpn" and mode ~= "all" then mode = "wan" end
writef(LOCK, (readf("/proc/self/stat") or ""):match("^(%d+)") or "1")
os.remove(CANCEL)

local function wan_dev()
    local best, bm = nil, nil
    for line in sh("ip -4 route show default"):gmatch("[^\n]+") do
        local dev = line:match(" dev (%S+)"); local metric = tonumber(line:match(" metric (%d+)") or "0")
        if dev and (not bm or metric < bm) then best, bm = dev, metric end
    end
    if best then return best end
    local d = trim(sh("uci -q get network.wan.device")); if d == "" then d = trim(sh("uci -q get network.wan.ifname")) end
    return d ~= "" and d or "eth1"
end

local targets = {}
if mode == "wan" or mode == "all" then
    targets[1] = { iface = wan_dev(), kind = "wan" }
end
if mode == "vpn" or mode == "all" then
    local now = os.time()
    local hs, vpn = {}, {}
    for iface, ts in sh("wg show all latest-handshakes"):gmatch("(%S+)%s+%S+%s+(%d+)") do hs[iface] = tonumber(ts) end
    for name in sh("ls /sys/class/net"):gmatch("%S+") do
        if name:match("^wgclient%d+$") and hs[name] and now - hs[name] < 180 then vpn[#vpn + 1] = { iface = name, kind = "vpn" } end
        -- OpenVPN tunnels (2026-11-17): tested when GL reports them connected
        if name:match("^ovpnclient%d+$") and trim(readf("/tmp/ovpnclient/" .. name .. "_state") or "") == "connected" then vpn[#vpn + 1] = { iface = name, kind = "vpn" } end
    end
    table.sort(vpn, function(a, b) return a.iface < b.iface end)
    for _, t in ipairs(vpn) do if not only or t.iface == only then targets[#targets + 1] = t end end
end

local st = { running = true, mode = mode, only = only or cjson.null, started = os.time(), total = #targets, index = 0, results = {}, current = cjson.null }
local function save() writef(STATE, cjson.encode(st)) end
save()

local cancelled = false
for i, t in ipairs(targets) do
    if exists(CANCEL) then cancelled = true; break end
    st.index = i
    local cur = { iface = t.iface, kind = t.kind, phase = "connecting", progress = 0 }
    st.current = cur; save()
    local res, err = nil, nil
    local p = io.popen(BIN .. " --accept-license --accept-gdpr -I " .. t.iface .. " -f jsonl -p yes 2>&1")
    if p then
        for line in p:lines() do
            local ok, ev = pcall(cjson.decode, line)
            if ok and type(ev) == "table" then
                if ev.type == "testStart" and type(ev.server) == "table" then
                    cur.server = { name = ev.server.name, location = ev.server.location }; cur.phase = "ping"
                elseif ev.type == "ping" and type(ev.ping) == "table" then
                    cur.phase = "ping"; cur.progress = ev.ping.progress; cur.ping = ev.ping.latency
                elseif ev.type == "download" and type(ev.download) == "table" then
                    cur.phase = "download"; cur.progress = ev.download.progress; cur.down = (ev.download.bandwidth or 0) * 8 / 1e6
                elseif ev.type == "upload" and type(ev.upload) == "table" then
                    cur.phase = "upload"; cur.progress = ev.upload.progress; cur.up = (ev.upload.bandwidth or 0) * 8 / 1e6
                elseif ev.type == "result" then
                    res = {
                        iface = t.iface, kind = t.kind, time = os.time(),
                        server = cur.server or cjson.null,
                        ping = ev.ping and ev.ping.latency or cjson.null, jitter = ev.ping and ev.ping.jitter or cjson.null,
                        down = ev.download and (ev.download.bandwidth or 0) * 8 / 1e6 or cjson.null,
                        up = ev.upload and (ev.upload.bandwidth or 0) * 8 / 1e6 or cjson.null,
                        down_bytes = ev.download and ev.download.bytes or 0, up_bytes = ev.upload and ev.upload.bytes or 0,
                        loss = ev.packetLoss or cjson.null,
                        -- latency while the line is saturated (bufferbloat)
                        dl_lat = ev.download and type(ev.download.latency) == "table" and ev.download.latency.iqm or cjson.null,
                        ul_lat = ev.upload and type(ev.upload.latency) == "table" and ev.upload.latency.iqm or cjson.null
                    }
                elseif ev.type == "log" and ev.level == "error" then
                    err = ev.message
                end
                save()
            elseif line:match("%S") and not line:match("^[=%s]") and #line < 200 then
                if line:lower():match("error") then err = trim(line) end
            end
        end
        p:close()
    end
    if exists(CANCEL) then cancelled = true end
    st.results[#st.results + 1] = res or { iface = t.iface, kind = t.kind, time = os.time(), error = cancelled and "Cancelled" or (err or "Test failed") }
    save()
    if cancelled then break end
end

st.running = false; st.current = cjson.null; st.finished = os.time(); st.cancelled = cancelled
if #targets == 0 then st.error = only and "That VPN tunnel isn't connected right now" or (mode == "vpn") and "No connected VPN tunnels to test" or "No WAN interface found" end
save()
if not cancelled and #st.results > 0 then
    local ok, last = pcall(cjson.decode, readf(LAST) or "")
    if not ok or type(last) ~= "table" then last = {} end
    -- store per kind so "all" runs update both the Internet and VPN groups
    local by = {}
    for _, r in ipairs(st.results) do by[r.kind] = by[r.kind] or {}; table.insert(by[r.kind], r) end
    for kind, list in pairs(by) do
        -- one tunnel tested: replace only its row and keep the other tunnels' earlier results (each has its own time)
        if only and kind == "vpn" and type(last.vpn) == "table" and type(last.vpn.results) == "table" then
            local merged, done = {}, false
            for _, r in ipairs(last.vpn.results) do
                if type(r) == "table" and r.iface == only then if not done then for _, n in ipairs(list) do merged[#merged + 1] = n end; done = true end
                elseif type(r) == "table" then merged[#merged + 1] = r end
            end
            if not done then for _, n in ipairs(list) do merged[#merged + 1] = n end end
            list = merged
        end
        last[kind] = { finished = st.finished, results = list }
    end
    writef(LAST, cjson.encode(last))
end
os.remove(LOCK); os.remove(CANCEL)
