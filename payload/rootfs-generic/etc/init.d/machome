#!/bin/sh /etc/rc.common
# Background sampler for the macOS-style Home tab
START=99
STOP=10
USE_PROCD=1

SAVE=/etc/machome/save
RAM=/tmp/machome

start_service() {
    # after a reboot, bring back the 24 h graphs / hourly usage saved at shutdown (only if < 24 h old)
    if [ ! -f $RAM/hist ] && [ -f $SAVE/hist ] && [ -n "$(find $SAVE/hist -mmin -1440 2>/dev/null)" ]; then
        mkdir -p $RAM && cp -p $SAVE/hist $SAVE/usage-hourly.json $SAVE/rel_cur.json $RAM/ 2>/dev/null
    fi
    # event timeline: always bring it back (it keeps 14 days by itself)
    [ -f $RAM/events.json ] || { mkdir -p $RAM; cp -p $SAVE/events.json $RAM/ 2>/dev/null; }
    [ -f $RAM/dnswatch.json ] || cp -p $SAVE/dnswatch.json $RAM/ 2>/dev/null
    procd_open_instance
    procd_set_param command /usr/bin/lua /usr/bin/machome-sampler
    procd_set_param respawn 3600 5 0
    procd_close_instance
}

stop_service() {
    mkdir -p $SAVE && cp -p $RAM/hist $RAM/usage-hourly.json $RAM/rel_cur.json $RAM/events.json $RAM/dnswatch.json $SAVE/ 2>/dev/null
    # "shut down normally" marker: missing at the next boot = power cut or crash (health.lua alerts once)
    date +%s > /etc/machome/clean_shutdown 2>/dev/null
    # the sampler's continuous pingers (VPN tunnels 2026-11-20; an access point's internet check 2.6.2): never leave
    # them running without it. They're exactly "ping -I <iface> <ip>" (one-shot checks start "ping -q -c").
    for p in $(ps w | awk '/ ping -I [^ ]+ [0-9.]+$/ {print $1}'); do kill $p 2>/dev/null; done
    return 0
}
