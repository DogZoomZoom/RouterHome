#!/usr/bin/lua
-- machome-sampler: background collector for the Home tab.
-- Every 10 s: latency (direct + each WireGuard / OpenVPN tunnel), DNS health, WG handshakes (OpenVPN: last heard).
-- Every 60 s: 24 h history (temp + WAN bytes), security checks, new-device tracking.
-- Writes to /tmp/machome (RAM). Only /etc/machome/seen (known MACs) touches flash, and only when a new device appears.

local cjson = require "cjson"
local socket = require "socket"

local DIR = "/tmp/machome"
local SEEN = "/etc/machome/seen"
local HIST = DIR .. "/hist"
local HIST_MAX = 1440
local PH_MAX = 60
os.execute("mkdir -p " .. DIR .. " /etc/machome")

local function readf(p)
    local f = io.open(p, "r"); if not f then return nil end
    local s = f:read("*a"); f:close(); return s
end
local function writef(p, s)
    local tmp = p .. ".tmp"
    local f = io.open(tmp, "w"); if not f then return end
    f:write(s); f:close(); os.rename(tmp, p)
end
local function trim(s) return s and (s:gsub("^%s+", ""):gsub("%s+$", "")) or "" end
local function sh(cmd)
    local p = io.popen(cmd .. " 2>/dev/null"); if not p then return "" end
    local s = p:read("*a") or ""; p:close(); return s
end
local function num(p) local s = readf(p); return s and tonumber((s:gsub("%s", ""))) end
local function uci_get(k) return trim(sh("uci -q get " .. k)) end

local function wan_dev()
    -- follow the active uplink (Ethernet WAN, repeater, tethering, modem) via the lowest-metric default route
    local best, bm = nil, nil
    for line in sh("ip -4 route show default"):gmatch("[^\n]+") do
        local dev = line:match(" dev (%S+)"); local metric = tonumber(line:match(" metric (%d+)") or "0")
        if dev and (not bm or metric < bm) then best, bm = dev, metric end
    end
    if best then return best end
    local d = uci_get("network.wan.device")
    if d == "" then d = uci_get("network.wan.ifname") end
    return d ~= "" and d or "eth1"
end

-- next hop of the internet connection (the cable modem, or the main router for an access point); nil if none
local function wan_gw(dev)
    for line in sh("ip -4 route show default"):gmatch("[^\n]+") do
        local via, d = line:match("via (%d+%.%d+%.%d+%.%d+)"), line:match(" dev (%S+)")
        if via and (d == dev or not dev) then return via end
    end
end
-- the router's own internet address: private (modem in router mode = double NAT) or carrier-grade NAT?
local function wan_nat(dev)
    local ip = sh("ip -4 -o addr show dev " .. dev):match("inet (%d+%.%d+%.%d+%.%d+)")
    if not ip then return nil end
    local a, b = ip:match("^(%d+)%.(%d+)"); a, b = tonumber(a), tonumber(b)
    if a == 10 or (a == 172 and b >= 16 and b <= 31) or (a == 192 and b == 168) then return "private", ip end
    if a == 100 and b >= 64 and b <= 127 then return "cgnat", ip end
    return "public", ip
end

-- What to ping as "the modem" (2026-11-20). Router mode (private WAN address) / access point: the gateway IS the
-- modem (or the main router). Bridge mode (public or CGNAT address): the gateway is the ISP's router, which may ignore
-- pings (Xfinity's does: 100% loss), so ping the cable modem's own management address instead: 192.168.100.1 (every
-- DOCSIS modem) or 10.0.0.1 (Xfinity gateways). Re-chosen every 10 min; if none answers, keep the last one that did
-- (so a dead modem shows "no answer"), else fall back to the gateway.
local MODEM_ADDRS = { "192.168.100.1", "10.0.0.1" }
local mh_pick, mh_t = nil, 0
local MODEM_NOW = nil               -- the address pinged as "the modem" this round (Network Health shows it)
local function modem_host(dev, now)
    local gw = wan_gw(dev)
    local nat = wan_nat(dev)
    if nat == "private" or nat == nil then return gw end
    if not mh_pick or now - mh_t >= 600 then
        mh_t = now
        for _, a in ipairs(MODEM_ADDRS) do
            if sh("ping -c 1 -W 1 -I " .. dev .. " " .. a .. " 2>/dev/null"):match("time=") then
                if mh_pick ~= a then os.execute("logger -t machome 'modem check: bridge mode, pinging the modem at " .. a .. "'") end
                mh_pick = a; break
            end
        end
    end
    return mh_pick or gw
end

-- VPN client tunnels: WireGuard (wgclientN) and OpenVPN (ovpnclientN, added 2026-11-17: same checks for both)
local function is_tun(n) return type(n) == "string" and (n:match("^wgclient%d+$") or n:match("^ovpnclient%d+$")) ~= nil end
local function vpn_ifaces()
    local out = {}
    for name in sh("ls /sys/class/net"):gmatch("%S+") do
        if is_tun(name) then out[#out + 1] = name end
    end
    table.sort(out)
    return out
end

local function lan_dns()
    local opts = sh("uci -q get dhcp.lan.dhcp_option")
    for o in opts:gmatch("%S+") do
        local code, rest = o:match("^([%w:%-]+),(.*)$")
        if code == "6" or code == "option:dns-server" then
            local ip = rest:match("^([^,]+)")
            if ip then return ip end
        end
    end
    return "127.0.0.1"
end

-- parallel pings: targets = { {key=, iface=, alt=} }. A target with `alt` (the VPN tunnels) is pinged at two
-- different servers at the same time (Cloudflare 1.1.1.1 + Quad9 9.9.9.9). The tunnel counts as working if EITHER
-- answers: one server briefly ignoring pings (VPN exit addresses are shared by many users) is not a VPN outage.
-- Only when both servers get no answer is the loss reported (and the tunnel called down). Owner's choice 2026-11-13.
local function parse(f)
    local out = readf(f) or ""
    local tx, rx = out:match("(%d+) packets transmitted, (%d+) packets received")
    local avg = out:match("min/avg/max = [%d%.]+/([%d%.]+)/")
    tx = tonumber(tx) or 3; rx = tonumber(rx) or 0
    return tx > 0 and math.floor((tx - rx) * 100 / tx + 0.5) or 100, avg and (math.floor(tonumber(avg) * 10 + 0.5) / 10) or nil
end
local function pings(targets)
    local parts = {}
    for _, t in ipairs(targets) do
        parts[#parts + 1] = string.format("(ping -q -c 3 -W 1 -I %s %s > %s/p_%s 2>&1) &", t.iface, t.host or "1.1.1.1", DIR, t.key)
        if t.alt then parts[#parts + 1] = string.format("(ping -q -c 3 -W 1 -I %s %s > %s/p_%s_b 2>&1) &", t.iface, t.alt, DIR, t.key) end
        if t.alt2 then parts[#parts + 1] = string.format("(ping -q -c 3 -W 1 -I %s %s > %s/p_%s_c 2>&1) &", t.iface, t.alt2, DIR, t.key) end
    end
    os.execute(table.concat(parts, " ") .. " wait")
    local res = {}
    for _, t in ipairs(targets) do
        local loss, ms = parse(DIR .. "/p_" .. t.key)
        local alt_used = false
        local each = nil
        if t.alt then
            local loss2, ms2 = parse(DIR .. "/p_" .. t.key .. "_b")
            -- each server's own result, for the VPN Health card (2026-11-15)
            each = { { loss = loss, ms = ms or cjson.null }, { loss = loss2, ms = ms2 or cjson.null } }
            if loss2 < loss then loss, ms, alt_used = loss2, ms2 or ms, true end   -- the tunnel works if either server answers
        end
        if t.alt2 then   -- WAN only (2026-11-17): Google 8.8.8.8 as a third server, for the Internet card's ping stats
            local loss3, ms3 = parse(DIR .. "/p_" .. t.key .. "_c")
            each = each or {}; each[3] = { loss = loss3, ms = ms3 or cjson.null }
            if loss3 < loss then loss, ms, alt_used = loss3, ms3 or ms, true end
        end
        res[t.key] = { ms = ms or cjson.null, loss = loss, iface = t.iface, alt = alt_used or nil, each = each }
    end
    return res
end

-- ---- VPN tunnels: ONE continuous ping per tunnel and server (owner-approved fix, 2026-11-20) -----------------------
-- Tested side by side through Nord: a new ping every second stalled 5 times in 20 min (70 s of "no reply"), one
-- continuous ping over the same 20 min lost 0 of 1200, and the owner's PC (a continuous ping) lost 0%. VPN servers
-- (Nord, Surfshark) block NEW ping sessions for ~30 s when one client opens many; they never touch real traffic.
-- So each tunnel keeps `ping -I <tunnel> <server>` running (1 a second), its output piped into awk that only
-- overwrites one small file "<replies> <sum of ms> <last ms>" (nothing grows). Every 10 s the sampler compares
-- with the previous read: replies in the window vs seconds elapsed = loss; new sum / new replies = average ms.
-- Watchdog: a dead pinger is restarted, pingers of removed tunnels are stopped, leftovers are cleared at start.
local CP_TARGETS = { "1.1.1.1", "9.9.9.9" }
local cp = {}                       -- "iface|target" -> { pid, t0, rcv, sum, t }
local cp_seen = {}                  -- keys started at least once in this run
local cp_rs, cp_note = {}, {}       -- restart times per key (last hour); last log note per tunnel
local function cp_file(ifc, tgt) return DIR .. "/cp_" .. ifc .. "_" .. tgt end
local function cp_kill_all(keep)
    -- continuous pingers look exactly like "ping -I wgclientN 1.1.1.1" (one-shot checks always have -c)
    for line in sh("ps w"):gmatch("[^\n]+") do
        local pid, ifc, tgt = line:match("^%s*(%d+)%s.-%sping %-I (%a+client%d+) (%d+%.%d+%.%d+%.%d+)%s*$")
        if pid and not (keep and keep[ifc .. "|" .. tgt]) then os.execute("kill " .. pid .. " >/dev/null 2>&1") end
    end
end
local function cp_start(ifc, tgt, now)
    local f = cp_file(ifc, tgt)
    os.remove(f)
    local awk = "awk -v f=" .. f .. " '{ if (match($0, /time=[0-9.]+/)) { n++; s += substr($0, RSTART + 5, RLENGTH - 5); " ..
        "printf \"%d %.3f %s\\n\", n, s, substr($0, RSTART + 5, RLENGTH - 5) > f; close(f) } }'"
    local pid = trim(sh("( ping -I " .. ifc .. " " .. tgt .. " 2>/dev/null | " .. awk .. " ) </dev/null >/dev/null 2>&1 & echo $!"))
    cp[ifc .. "|" .. tgt] = { pid = tonumber(pid), t0 = now, rcv = 0, sum = 0, t = now }
end
local function cp_alive(e) return e and e.pid and readf("/proc/" .. e.pid .. "/stat") ~= nil end
cp_kill_all(nil)                    -- leftovers from before a restart
-- one tunnel's result in the same shape as pings(): { ms, loss, iface, each = { Cloudflare, Quad9 } }
local function cp_tunnel(ifc, now)
    local each, bl, bm = {}, 101, nil
    for i, tgt in ipairs(CP_TARGETS) do
        local k = ifc .. "|" .. tgt
        local e = cp[k]
        local loss, ms
        if not cp_alive(e) then
            -- first start in this run: no verdict yet (0). A pinger that DIED (tunnel gone / down): 100% loss,
            -- so a dead tunnel can never hide behind restarts.
            loss = (e and cp_seen[k]) and 100 or 0
            if e and cp_seen[k] then
                -- a pinger that keeps dying = the tunnel keeps going away (2026-11-20): one quiet log note an hour
                local rs = cp_rs[k] or {}; rs[#rs + 1] = now
                while rs[1] and now - rs[1] > 3600 do table.remove(rs, 1) end
                cp_rs[k] = rs
                if #rs >= 3 and now - (cp_note[ifc] or 0) >= 3600 then
                    cp_note[ifc] = now
                    os.execute("logger -t machome 'continuous pings: the " .. ifc .. " pinger stopped " .. #rs .. " times in the last hour (the tunnel keeps going away; restarted each time)'")
                end
            end
            cp_seen[k] = true
            cp_start(ifc, tgt, now)
        else
            local n, s = (readf(cp_file(ifc, tgt)) or ""):match("^(%d+) ([%d%.]+)")
            n, s = tonumber(n) or e.rcv, tonumber(s) or e.sum
            local secs = math.max(1, math.floor(now - e.t + 0.5))
            local got = math.max(0, n - e.rcv)
            loss = math.max(0, math.min(100, math.floor((secs - got) * 100 / secs + 0.5)))
            ms = got > 0 and math.floor((s - e.sum) / got * 10 + 0.5) / 10 or nil
            e.rcv, e.sum, e.t = n, s, now
        end
        each[i] = { loss = loss, ms = ms or cjson.null }
        if loss < bl then bl, bm = loss, ms end
    end
    return { ms = bm or cjson.null, loss = bl, iface = ifc, each = each, cont = true }
end
local function cp_tick(vifs, now)
    local want, res = {}, {}
    for _, v in ipairs(vifs) do
        for _, tgt in ipairs(CP_TARGETS) do want[v .. "|" .. tgt] = true end
        local ok, r = pcall(cp_tunnel, v, now)
        if ok then res[v] = r end
    end
    -- tunnels that are gone: stop their pingers
    for k in pairs(cp) do if not want[k] then cp[k] = nil end end
    cp_kill_all(want)
    return res
end

local function dns_check(server)
    local t0 = socket.gettime()
    local out = sh("dig +time=2 +tries=1 @" .. server .. " example.com A")
    local wall = math.floor((socket.gettime() - t0) * 1000)
    local status = out:match("status: (%u+)")
    local qt = tonumber(out:match("Query time: (%d+) msec"))
    return { server = server, ok = status == "NOERROR", status = status or "TIMEOUT",
             ms = qt or (status and wall or cjson.null) }
end

-- OpenVPN has no handshake time. Its stand-in is "last heard from the server": the last time the tunnel's received
-- bytes went up while GL says it's connected. The server's keepalive (every 10-15 s) plus the pings through the
-- tunnel keep it fresh, so "stale" (> 180 s) means the same as for WireGuard: nothing has come back for 3 minutes.
local ov_rx, ov_t = {}, {}
local function ovpn_heard(now, t)
    for name in sh("ls /sys/class/net"):gmatch("%S+") do
        if name:match("^ovpnclient%d+$") then
            local rx = num("/sys/class/net/" .. name .. "/statistics/rx_bytes") or 0
            local conn = trim(readf("/tmp/ovpnclient/" .. name .. "_state") or "") == "connected"
            if conn and (not ov_rx[name] or rx ~= ov_rx[name] or not ov_t[name]) then ov_t[name] = now end
            if not conn and not ov_rx[name] then ov_t[name] = nil end
            ov_rx[name] = rx
            if ov_t[name] then t[name] = ov_t[name] end
        end
    end
    for name in pairs(ov_rx) do if not readf("/sys/class/net/" .. name .. "/operstate") then ov_rx[name] = nil; ov_t[name] = nil end end
end
local function wg_handshakes()
    local t = {}
    for iface, ts in sh("wg show all latest-handshakes"):gmatch("(%S+)%s+%S+%s+(%d+)") do
        local v = tonumber(ts)
        if not t[iface] or v > t[iface] then t[iface] = v end
    end
    pcall(ovpn_heard, os.time(), t)
    return t
end

local function max_temp()
    local m = nil
    for i = 0, 15 do
        local v = num("/sys/class/thermal/thermal_zone" .. i .. "/temp")
        if not v then break end
        v = v / 1000
        if not m or v > m then m = v end
    end
    return m or 0
end

local function svc_running(name)
    return sh("ubus call service list '{\"name\":\"" .. name .. "\"}'"):find('"running": true', 1, true) ~= nil
end

local function security()
    local c = {}
    local function add(id, label, ok, detail) c[#c + 1] = { id = id, label = label, ok = ok, detail = detail } end

    local pa = uci_get("dropbear.@dropbear[0].PasswordAuth")
    add("ssh", "SSH key-only login", pa == "off" or pa == "0", (pa == "off" or pa == "0") and "Password login disabled" or "Password login is ON")

    local keys = tonumber(trim(sh("grep -c 'ssh-' /etc/dropbear/authorized_keys"))) or 0
    add("keys", "Only your SSH key authorized", keys <= 1, keys .. " key" .. (keys == 1 and "" or "s"))

    local perm = trim(sh("ls -l /etc/config/wireguard")):match("^(%S+)") or ""
    add("wgperm", "VPN key file locked", perm == "-rw-------",
        perm == "" and "File missing" or (perm == "-rw-------" and "Root-only (600)" or ("Too open: " .. perm)))

    -- OpenVPN logins (2026-11-17): GL saves the provider username/password in /etc/config/ovpnclient and in each
    -- profile's auth/username_password.txt, readable by every process by default. Same rule as WireGuard: root-only.
    local ovf = {}
    if (readf("/etc/config/ovpnclient") or ""):find("option password", 1, true) then ovf[#ovf + 1] = "/etc/config/ovpnclient" end
    for f in sh("ls /etc/openvpn/profiles/*/auth/* 2>/dev/null"):gmatch("[^\n]+") do ovf[#ovf + 1] = f end
    -- GL rewrites them readable on every VPN save, so they're re-locked here (logged) instead of warning each time.
    if #ovf > 0 then
        local open, fixed = 0, 0
        for _, f in ipairs(ovf) do
            if not f:find("'", 1, true) and (trim(sh("ls -l '" .. f .. "'")):match("^(%S+)") or "") ~= "-rw-------" then
                os.execute("chmod 600 '" .. f .. "'")
                if (trim(sh("ls -l '" .. f .. "'")):match("^(%S+)") or "") == "-rw-------" then fixed = fixed + 1 else open = open + 1 end
            end
        end
        if fixed > 0 then os.execute("logger -t machome 'security: re-locked " .. fixed .. " OpenVPN login file(s) to root-only (GL saved them readable)'") end
        add("ovpnperm", "OpenVPN login files locked", open == 0, open == 0 and ("Root-only (600), " .. #ovf .. " file" .. (#ovf == 1 and "" or "s"))
            or (open .. " of " .. #ovf .. " readable by other programs"))
    end

    add("https", "HTTPS-only admin panel", uci_get("oui-httpd.main.redirect_https") == "1",
        uci_get("oui-httpd.main.redirect_https") == "1" and "HTTP redirects to HTTPS" or "Plain HTTP allowed")

    local wanin = ""
    for z in sh("uci show firewall | grep \"name='wan'\" | cut -d. -f2"):gmatch("%S+") do
        wanin = uci_get("firewall." .. z .. ".input"); break
    end
    add("wanfw", "Firewall blocks inbound", wanin == "DROP" or wanin == "REJECT", "WAN inbound: " .. (wanin ~= "" and wanin or "?"))

    local ipsec = false
    for sec in sh("uci show firewall | grep -E \"name='Allow-(IPSec-ESP|ISAKMP)'\""):gmatch("firewall%.([^%.]+)%.name") do
        if uci_get("firewall." .. sec .. ".enabled") ~= "0" then ipsec = true end
    end
    add("ipsec", "Unused IPsec rules off", not ipsec, ipsec and "Re-enabled" or "Disabled")

    local pf = tonumber(trim(sh("uci show firewall | grep -c '=redirect'"))) or 0
    add("pf", "No port forwards", pf == 0, pf == 0 and "None" or (pf .. " forward" .. (pf == 1 and "" or "s")))

    local upnp = svc_running("miniupnpd")
    add("upnp", "UPnP off", not upnp, upnp and "Running" or "Off")

    local remote = svc_running("gl-cloud") or svc_running("rtty")
    add("remote", "Cloud / remote access off", not remote, remote and "Running" or "Off")

    -- only checked for services the owner chose to disable on this router (/etc/machome/optimized, one per line)
    local opt = {}
    for s in (readf("/etc/machome/optimized") or ""):gmatch("[%w_%-]+") do opt[#opt + 1] = s end
    if #opt > 0 then
        local back = {}
        for _, s in ipairs(opt) do
            if os.execute("/etc/init.d/" .. s .. " enabled 2>/dev/null") == 0 then back[#back + 1] = s end
        end
        add("svc", "Optimized services stay off", #back == 0, #back == 0 and ("All " .. #opt .. " still disabled") or ("Re-enabled: " .. table.concat(back, ", ")))
    end

    if readf("/etc/sysctl.d/99-vpn-tune.conf") then
        local bl = tonumber(trim(readf("/proc/sys/net/core/netdev_max_backlog") or "")) or 0
        local bu = tonumber(trim(readf("/proc/sys/net/core/netdev_budget") or "")) or 0
        local rps = trim(readf("/sys/class/net/" .. wan_dev() .. "/queues/rx-0/rps_cpus") or "")
        local ok = bl >= 5000 and bu >= 600 and rps == "e"
        add("vpntune", "VPN speed tuning applied", ok, ok and "Queue 5000 · cores 1-3" or ("Queue " .. bl .. " · budget " .. bu .. " · RPS " .. rps))
    end

    return c
end

local function load_seen()
    local s = readf(SEEN)
    if not s then return nil end
    local t = {}
    for m, ts in s:gmatch("(%S+) (%d+)") do t[m] = tonumber(ts) end
    return t
end
local function save_seen(t)
    local lines = {}
    for m, ts in pairs(t) do lines[#lines + 1] = m .. " " .. string.format("%.0f", ts) end
    table.sort(lines)
    writef(SEEN, table.concat(lines, "\n") .. "\n")
end
local function current_macs()
    local t = {}
    for line in (readf("/proc/net/arp") or ""):gmatch("[^\n]+") do
        local flags, mac, dev = line:match("^%S+%s+%S+%s+(%S+)%s+(%S+)%s+%S+%s+(%S+)")
        if mac and dev == "br-lan" and flags ~= "0x0" and mac ~= "00:00:00:00:00:00" then t[mac:upper()] = true end
    end
    for line in (readf("/tmp/dhcp.leases") or ""):gmatch("[^\n]+") do
        local mac = line:match("^%d+ (%S+)")
        if mac then t[mac:upper()] = true end
    end
    return t
end

local function load_hist()
    local rows = {}
    for line in (readf(HIST) or ""):gmatch("[^\n]+") do rows[#rows + 1] = line end
    return rows
end

-- optional extras (alerts, reliability, usage, nightly test, firmware watch); failures never stop the sampler
local X = nil
do
    local ok, mod = pcall(dofile, "/usr/lib/machome/extras.lua")
    if ok and type(mod) == "table" then X = mod else os.execute("logger -t machome 'extras not loaded: " .. tostring(mod):gsub("'", "") .. "'") end
end

-- state
local hist = load_hist()
local ph = {}            -- key -> latency history (ms or -1 for loss)
local pl = {}            -- key -> packet-loss history (% per 3-ping sample)
local dh = {}            -- dns latency history
local seen = load_seen()
local sec = {}
local last_min = 0

-- WAN ping stats for the Internet card (owner, 2026-11-17): Cloudflare, Google and Quad9 pinged DIRECTLY over the
-- internet connection (not the VPN) every 10 s. Per server: 24 h of one-minute buckets {minute, sum of ms, replies,
-- pings sent, pings lost} (RAM, /tmp/machome/wanping.json, saved every minute so a service restart keeps them) and
-- the last 60 checks (10 min) for jitter. live.json gets a small summary + a 24 h graph in 15-minute steps.
local WP_SRV = { "1.1.1.1", "8.8.8.8", "9.9.9.9" }
local WP_IDX = { ["1.1.1.1"] = 1, ["9.9.9.9"] = 2, ["8.8.8.8"] = 3 }   -- position in ping.wan.each
local WP_FILE = DIR .. "/wanping.json"
local wp = { b = {}, r = {} }
-- WAN health (Network Health card, 2026-11-17): best-of-three per check, one-minute buckets {minute, checks, sum ms of
-- answered checks, checks over the ping limit, checks with no answer at all} for 24 h; last 60 best values (jitter);
-- last 60 modem pings
local WH = { b = {}, r = {}, g = {}, lim = 75, lim_t = 0 }
do
    local ok, v = pcall(cjson.decode, readf(WP_FILE) or "")
    if ok and type(v) == "table" and type(v.b) == "table" then for _, s in ipairs(WP_SRV) do if type(v.b[s]) == "table" then wp.b[s] = v.b[s] end end end
    if ok and type(v) == "table" and type(v.wb) == "table" then WH.b = v.wb end
end
for _, s in ipairs(WP_SRV) do wp.b[s] = wp.b[s] or {}; wp.r[s] = {} end
local wp_saved = os.time()
local function r1(x) return math.floor(x * 10 + 0.5) / 10 end
local function wp_add(now, each)
    if type(each) ~= "table" then return end
    local m = now - now % 60
    for _, s in ipairs(WP_SRV) do
        local e = each[WP_IDX[s]]
        if type(e) == "table" then
            local L = wp.b[s]; local b = L[#L]
            if not b or b[1] ~= m then b = { m, 0, 0, 0, 0 }; L[#L + 1] = b end
            b[4] = b[4] + 3; b[5] = b[5] + math.floor((tonumber(e.loss) or 100) * 3 / 100 + 0.5)
            local ms = tonumber(e.ms)
            if ms then b[2] = b[2] + ms; b[3] = b[3] + 1 end
            while L[1] and now - L[1][1] >= 86400 do table.remove(L, 1) end
            local r = wp.r[s]; r[#r + 1] = ms or -1; while #r > 60 do table.remove(r, 1) end
        end
    end
    if now - wp_saved >= 60 then wp_saved = now; writef(WP_FILE, cjson.encode({ b = wp.b, wb = WH.b })) end   -- RAM file; a restart loses at most a minute
end
local function wp_summary(now)
    local out = {}
    for _, s in ipairs(WP_SRV) do
        local L, r = wp.b[s], wp.r[s]
        local function agg(age)
            local sum, n, sent, lost = 0, 0, 0, 0
            for i = #L, 1, -1 do local b = L[i]; if now - b[1] >= age then break end; sum = sum + b[2]; n = n + b[3]; sent = sent + b[4]; lost = lost + b[5] end
            return { ms = n > 0 and r1(sum / n) or cjson.null, loss = sent > 0 and r1(lost * 100 / sent) or cjson.null }
        end
        -- jitter: average change between back-to-back replies over the last 10 minutes
        local jd, jn, prev = 0, 0, nil
        for _, v in ipairs(r) do if v >= 0 then if prev then jd = jd + math.abs(v - prev); jn = jn + 1 end; prev = v else prev = nil end end
        -- 24 h: lowest / highest one-minute average, and the graph (96 x 15 min)
        local lo, hi, acc = nil, nil, {}
        local start = now - now % 900 - 95 * 900
        for _, b in ipairs(L) do
            if b[3] > 0 then
                local a = b[2] / b[3]; if not lo or a < lo then lo = a end; if not hi or a > hi then hi = a end
                local k = math.floor((b[1] - start) / 900)
                if k >= 0 and k < 96 then acc[k] = acc[k] or { 0, 0 }; acc[k][1] = acc[k][1] + b[2]; acc[k][2] = acc[k][2] + b[3] end
            end
        end
        local series = {}
        for k = 0, 95 do series[k + 1] = (acc[k] and acc[k][2] > 0) and r1(acc[k][1] / acc[k][2]) or -1 end
        -- last hour: 60 one-minute averages (2026-11-17 evening: the 1 h graph fills in within minutes)
        local m0 = now - now % 60 - 59 * 60
        local s1 = {}; for k = 1, 60 do s1[k] = -1 end
        for i = #L, 1, -1 do local b = L[i]; if b[1] < m0 then break end; local k = (b[1] - m0) / 60 + 1; if b[3] > 0 and s1[k] then s1[k] = r1(b[2] / b[3]) end end
        local last = r[#r]
        out[#out + 1] = { ip = s, now = (last and last >= 0) and last or cjson.null, m10 = agg(600), h1 = agg(3600), h24 = agg(86400),
            jitter = jn > 0 and r1(jd / jn) or cjson.null, lo = lo and r1(lo) or cjson.null, hi = hi and r1(hi) or cjson.null,
            since = L[1] and L[1][1] or cjson.null, series = series, s1 = s1 }
    end
    return { servers = out, step = 900, t = now, s1start = now - now % 60 - 59 * 60, s24start = now - now % 900 - 95 * 900 }
end

-- ---- WAN health (owner, 2026-11-17 evening): grade, spikes, jitter, "good for", modem vs internet, NAT, uptime, 24 h strip
local function wh_limit(now)   -- the high-ping limit from the Discord alert settings (default 75 ms)
    if now - WH.lim_t >= 60 then
        WH.lim_t = now
        local ok, a = pcall(cjson.decode, readf("/etc/machome/alerts.json") or "")
        WH.lim = (ok and type(a) == "table" and tonumber(a.ping_ms)) or 75
    end
    return WH.lim
end
local function wh_add(now, wanr, gwr)
    local lim = wh_limit(now)
    local best
    if wanr and type(wanr.each) == "table" then for _, e in ipairs(wanr.each) do local ms = tonumber(e.ms); if ms and (not best or ms < best) then best = ms end end end
    local m = now - now % 60
    local L = WH.b; local b = L[#L]
    if not b or b[1] ~= m then b = { m, 0, 0, 0, 0 }; L[#L + 1] = b end
    b[2] = b[2] + 1
    if best then b[3] = b[3] + best; if best > lim then b[4] = b[4] + 1 end else b[5] = b[5] + 1 end
    while L[1] and now - L[1][1] >= 86400 do table.remove(L, 1) end
    local r = WH.r; r[#r + 1] = best or -1; while #r > 60 do table.remove(r, 1) end
    local g = WH.g; g[#g + 1] = (gwr and gwr.ms ~= cjson.null and tonumber(gwr.ms)) or -1; while #g > 60 do table.remove(g, 1) end
end
local function median(t) if #t == 0 then return nil end; table.sort(t); return t[math.ceil(#t / 2)] end
-- verdict for a window: avg/median ms, spike share, no-answer %, jitter
local function wh_grade(med, spk, loss, jit, lim)
    local why = {}
    if med and med > lim then why[#why + 1] = "ping " .. math.floor(med + 0.5) .. " ms" end
    if spk >= 0.05 then why[#why + 1] = math.floor(spk * 100 + 0.5) .. "% lag spikes" end
    if loss >= 0.5 then why[#why + 1] = r1(loss) .. "% no answer" end
    if jit and jit >= 30 then why[#why + 1] = "jitter " .. math.floor(jit + 0.5) .. " ms" end
    local poor = (med and med > lim) or spk >= 0.25 or loss >= 2 or (jit and jit >= 60)
    local fair = (med and med > lim * 0.6) or spk >= 0.05 or loss >= 0.5 or (jit and jit >= 30)
    return poor and "poor" or fair and "fair" or "good", why
end
local function wh_use(med, spk, loss, jit, bad, warn)   -- thresholds per activity
    med = med or 0; jit = jit or 0
    if med > bad[1] or spk >= bad[2] or loss >= bad[3] or jit >= bad[4] then return "bad" end
    if med > warn[1] or spk >= warn[2] or loss >= warn[3] or jit >= warn[4] then return "warn" end
    return "ok"
end
local out_cache, out_t = nil, 0
local function wh_summary(now, wan, extras_wan_since)
    local lim = wh_limit(now)
    local L = WH.b
    -- last hour
    local n, sum, ans, over, lost, mins = 0, 0, 0, 0, 0, {}
    for i = #L, 1, -1 do
        local b = L[i]; if now - b[1] >= 3600 then break end
        n = n + b[2]; sum = sum + b[3]; over = over + b[4]; lost = lost + b[5]; ans = ans + (b[2] - b[5])
        if b[2] - b[5] > 0 then mins[#mins + 1] = b[3] / (b[2] - b[5]) end
    end
    local med = median(mins)
    local spk = ans > 0 and over / ans or 0
    local loss = n > 0 and lost * 100 / n or 0
    -- jitter: average change between back-to-back answered checks, last 10 min
    local jd, jn, prev = 0, 0, nil
    for _, v in ipairs(WH.r) do if v >= 0 then if prev then jd = jd + math.abs(v - prev); jn = jn + 1 end; prev = v else prev = nil end end
    local jit = jn > 0 and jd / jn or nil
    local grade, why = "good", {}
    if n >= 30 then grade, why = wh_grade(med, spk, loss, jit, lim) end
    -- what it's good for (ms, spike share, loss %, jitter): bad / warn limits
    local uses = n >= 30 and {
        browse = wh_use(med, spk, loss, jit, { 300, 0.5, 5, 200 }, { 150, 0.25, 1, 100 }),
        calls  = wh_use(med, spk, loss, jit, { 150, 0.25, 2, 50 }, { 100, 0.05, 0.5, 30 }),
        gaming = wh_use(med, spk, loss, jit, { 100, 0.1, 1, 30 }, { 60, 0.02, 0.3, 15 }) } or cjson.null
    -- modem (next hop) vs beyond it, last 10 min
    local gv, gl, gn = {}, 0, #WH.g
    for _, v in ipairs(WH.g) do if v >= 0 then gv[#gv + 1] = v else gl = gl + 1 end end
    local iv, il = {}, 0
    for _, v in ipairs(WH.r) do if v >= 0 then iv[#iv + 1] = v else il = il + 1 end end
    local gmed, imed = median(gv), median(iv)
    local hop = cjson.null
    if gn >= 6 then hop = { modem_ms = gmed and r1(gmed) or cjson.null, modem_loss = r1(gl * 100 / gn), net_ms = imed and r1(imed) or cjson.null,
        net_loss = #WH.r > 0 and r1(il * 100 / #WH.r) or cjson.null } end
    -- 24 h strip: one verdict per hour (oldest first), nil where there's no data
    local strip, h0 = {}, now - now % 3600 - 23 * 3600
    local hb = {}
    for _, b in ipairs(L) do
        local k = math.floor((b[1] - h0) / 3600)
        if k >= 0 and k < 24 then
            local x = hb[k] or { n = 0, sum = 0, over = 0, lost = 0, mins = {} }
            x.n = x.n + b[2]; x.sum = x.sum + b[3]; x.over = x.over + b[4]; x.lost = x.lost + b[5]
            if b[2] - b[5] > 0 then x.mins[#x.mins + 1] = b[3] / (b[2] - b[5]) end
            hb[k] = x
        end
    end
    for k = 0, 23 do
        local x = hb[k]
        if x and x.n >= 30 then
            local a = x.n - x.lost
            local g = wh_grade(median(x.mins), a > 0 and x.over / a or 0, x.lost * 100 / x.n, nil, lim)
            strip[k + 1] = { g = g, ms = median(x.mins) and r1(median(x.mins)) or cjson.null, spk = a > 0 and math.floor(x.over * 100 / a + 0.5) or 0 }
        else strip[k + 1] = cjson.null end
    end
    -- uptime today / 7 days + last outage, from the outage log (once a minute; the open outage comes from extras)
    if not out_cache or now - out_t >= 60 then
        out_t = now
        local ok, o = pcall(cjson.decode, readf("/etc/machome/outages.json") or "[]")
        out_cache = (ok and type(o) == "table") and o or {}
    end
    local t = os.date("*t", now); local mid = os.time({ year = t.year, month = t.month, day = t.day, hour = 0 })
    local function down_since(s0)
        local d = 0
        for _, o in ipairs(out_cache) do if type(o) == "table" and o.s and o.e and o.e > s0 then d = d + (o.e - math.max(o.s, s0)) end end
        if extras_wan_since and extras_wan_since > 0 then d = d + (now - math.max(extras_wan_since, s0)) end
        return d
    end
    local last = out_cache[#out_cache]
    local nat, natip = wan_nat(wan)
    return { grade = n >= 30 and grade or cjson.null, why = why, limit = lim, med = med and r1(med) or cjson.null,
        spikes = over, checks = ans, spk = r1(spk * 100), loss = r1(loss), jitter = jit and r1(jit) or cjson.null, uses = uses,
        hop = hop, gw = MODEM_NOW or wan_gw(wan) or cjson.null, nat = nat or cjson.null, wanip = natip or cjson.null,
        up_today = r1(100 - down_since(mid) * 100 / math.max(1, now - mid)), up_7d = r1(100 - down_since(now - 7 * 86400) * 100 / (7 * 86400)),
        down_now = extras_wan_since or cjson.null,
        last_out = (type(last) == "table" and last.s) and { s = last.s, e = last.e } or cjson.null,
        strip = strip, strip_start = h0 }
end

while true do
    local t0 = socket.gettime()
    local now = os.time()
    local wan = wan_dev()
    local vifs = vpn_ifaces()

    -- internet check: Cloudflare + Quad9 (owner's choice 2026-11-13) + Google (2026-11-17, for the Internet card's
    -- ping stats) at once; "down" only when none of them answers
    local targets = { { key = "wan", iface = wan, alt = "9.9.9.9", alt2 = "8.8.8.8" } }
    -- VPN tunnels: continuous pingers since 2026-11-20 (cp_tick below), not a new ping every check
    -- the modem / upstream gateway too (Network Health "where is the problem", 2026-11-17); taken out of p right away
    local gwip = modem_host(wan, now)
    MODEM_NOW = gwip
    if gwip then targets[#targets + 1] = { key = "gw", iface = wan, host = gwip } end
    local p = pings(targets)
    local gwr = p.gw; p.gw = nil
    local okc, cpr = pcall(cp_tick, vifs, socket.gettime())
    if okc then for k, r in pairs(cpr) do p[k] = r end
    else os.execute("logger -t machome 'continuous pings: " .. tostring(cpr):gsub("'", ""):sub(1, 150) .. "'") end
    -- "Clear" on a packet-loss warning, a tunnel change or "Clear all VPN alerts" (2026-11-16): start that
    -- loss/latency history fresh. /tmp/machome/pl_reset holds keys (wgclientN, ovpnclientN, wan) or "vpn" for every tunnel.
    local rs = readf(DIR .. "/pl_reset")
    if rs then
        os.remove(DIR .. "/pl_reset")
        for k in rs:gmatch("%S+") do
            if k == "vpn" then for kk in pairs(pl) do if is_tun(kk) then pl[kk] = {}; ph[kk] = {} end end
            elseif pl[k] then pl[k] = {}; ph[k] = {} end
        end
        os.execute("logger -t machome 'packet-loss history cleared: " .. (rs:gsub("%s+", " "):gsub("[^%w ]", "")) .. "'")
    end
    for k, r in pairs(p) do
        ph[k] = ph[k] or {}
        local a = ph[k]
        a[#a + 1] = (r.ms ~= cjson.null) and r.ms or -1
        while #a > PH_MAX do table.remove(a, 1) end
        pl[k] = pl[k] or {}
        local b = pl[k]
        b[#b + 1] = r.loss or 100
        while #b > PH_MAX do table.remove(b, 1) end
    end
    for k in pairs(ph) do if not p[k] then ph[k] = nil; pl[k] = nil end end
    if p.wan then pcall(wp_add, now, p.wan.each) end
    local okwp, wps = pcall(wp_summary, now)
    pcall(wh_add, now, p.wan, gwr)
    local okwh, whs = pcall(wh_summary, now, wan, X and X.wan_since or nil)
    if not okwh and now % 600 < 10 then os.execute("logger -t machome 'wan health: " .. tostring(whs):gsub("'", ""):sub(1, 150) .. "'") end

    local dns = dns_check(lan_dns())
    dh[#dh + 1] = dns.ok and (dns.ms ~= cjson.null and dns.ms or 0) or -1
    while #dh > PH_MAX do table.remove(dh, 1) end

    local newmacs = nil
    local maxT = max_temp()
    -- "It's mine" from the Home tab: mark device(s) as known so the new-device alert clears for good
    if seen then
        local a = readf(DIR .. "/ack_devices")
        if a then
            os.remove(DIR .. "/ack_devices")
            local ch = false
            for m in a:gmatch("%S+") do
                m = m:upper()
                if m == "ALL" then for k, v in pairs(seen) do if v > 0 then seen[k] = 0; ch = true end end
                elseif seen[m] and seen[m] > 0 then seen[m] = 0; ch = true end
            end
            if ch then save_seen(seen) end
        end
    end
    if now - last_min >= 60 then
        last_min = now
        -- history
        local rx = num("/sys/class/net/" .. wan .. "/statistics/rx_bytes") or 0
        local tx = num("/sys/class/net/" .. wan .. "/statistics/tx_bytes") or 0
        hist[#hist + 1] = string.format("%.0f %.1f %.0f %.0f", now, maxT, rx, tx)
        while #hist > HIST_MAX do table.remove(hist, 1) end
        writef(HIST, table.concat(hist, "\n") .. "\n")
        -- new devices
        local cur = current_macs()
        if not seen then
            seen = {}
            for m in pairs(cur) do seen[m] = 0 end   -- first run: everything currently here is "known"
            save_seen(seen)
        else
            local changed = false
            for m in pairs(cur) do if not seen[m] then seen[m] = now; changed = true; newmacs = newmacs or {}; newmacs[#newmacs + 1] = m end end
            if changed then save_seen(seen) end
        end
        -- self-heal VPN tuning (GL hotplug scripts reset WAN RPS on tunnel ifup); logs only when it changes something
        if readf("/etc/sysctl.d/99-vpn-tune.conf") and readf("/usr/sbin/machome-vpn-rps") then
            os.execute("/usr/sbin/machome-vpn-rps periodic >/dev/null 2>&1")
        end
        -- security
        sec = security()
    end

    local wg = wg_handshakes()
    local extra = nil
    if X then
        local ok, err = pcall(X.tick, { now = now, ping = p, wg = wg, dns = dns, sec = sec, newmacs = newmacs, maxT = maxT, gw = gwr })
        if not ok then os.execute("logger -t machome 'extras tick: " .. tostring(err):gsub("'", ""):sub(1, 200) .. "'") end
        local ok2, lv = pcall(X.live); if ok2 then extra = lv end
    end

    -- zram (compressed swap in RAM, GL's zram-swap package; owner 2026-11-22): size, swapped, compression, peak.
    -- /proc/swaps "Used" is in kB; mm_stat = orig_data compr_data mem_used mem_limit mem_used_max ... (bytes)
    local zr = cjson.null
    do
        local sw = readf("/proc/swaps") or ""
        local size, used = sw:match("/dev/zram0%s+%S+%s+(%d+)%s+(%d+)")
        if size then
            local mm = {}; for v in (readf("/sys/block/zram0/mm_stat") or ""):gmatch("%d+") do mm[#mm + 1] = tonumber(v) end
            local algo = (readf("/sys/block/zram0/comp_algorithm") or ""):match("%[([%w%-]+)%]")
            local avail = (readf("/proc/meminfo") or ""):match("MemAvailable:%s+(%d+)")
            zr = { size = tonumber(size) * 1024, used = tonumber(used) * 1024, orig = mm[1] or 0, compr = mm[2] or 0,
                   mem = mm[3] or 0, peak = mm[5] or 0, algo = algo or cjson.null, avail = avail and tonumber(avail) * 1024 or cjson.null }
        end
    end

    writef(DIR .. "/live.json", cjson.encode({
        zram = zr,
        time = now, wan = wan, ping = p, ph = ph, pl = pl, dns = dns, dh = dh,
        wg = wg, sec = sec, seen = seen or {}, interval = 10, x = extra or cjson.null,
        wp = okwp and wps or cjson.null, wh = okwh and whs or cjson.null
    }))

    local el = socket.gettime() - t0
    socket.sleep(math.max(1, 10 - el))
end
