-- ---------------- one-click fixes (whitelisted actions only; slow restarts run in the background)
local function sh(c) local p = io.popen(c .. " 2>/dev/null"); if not p then return "" end; local s = p:read("*a") or ""; p:close(); return s end
local function bg(c) os.execute("/bin/sh -c '" .. c .. "' </dev/null >/dev/null 2>&1 &") end
local function flog(msg) os.execute("logger -t machome-fix '" .. msg:gsub("'", "") .. "'") end

function M.fix(args)
    args = args or {}
    local a, t = args.action, args.target
    if a == "vpn" then
        if type(t) ~= "string" or not (t:match("^wgclient%d+$") or t:match("^ovpnclient%d+$")) then return { ok = false, err = "invalid tunnel" } end
        flog("restart tunnel " .. t); bg("ifdown " .. t .. "; sleep 2; ifup " .. t)
        return { ok = true, msg = "Restarting " .. t .. ". It should reconnect within about 15 seconds." }
    elseif a == "wan" then
        flog("renew WAN"); bg("ifup wan")
        return { ok = true, msg = "Renewing the internet connection. Give it about 30 seconds." }
    elseif a == "dns" then
        local srv = trim(sh("uci -q get dhcp.lan.dhcp_option | tr ' ' '\\n' | sed -n 's/^6,\\([^,]*\\).*/\\1/p' | head -1"))
        if srv == "" then srv = "127.0.0.1" end
        local ping = sh("ping -c 2 -W 1 " .. srv):match("(%d+) packets received")
        local dig = sh("dig +time=2 +tries=1 @" .. srv .. " example.com A"):match("status: (%u+)")
        flog("dns check " .. srv .. " ping=" .. tostring(ping) .. " dns=" .. tostring(dig) .. "; restart dnsmasq")
        bg("/etc/init.d/dnsmasq restart")
        local up = tonumber(ping or "0") > 0
        return { ok = true, server = srv, reachable = up, answering = dig == "NOERROR",
            msg = (dig == "NOERROR") and ("DNS server " .. srv .. " is answering again. Restarted the router's DNS service too.")
                or (up and ("DNS server " .. srv .. " is online but its DNS isn't answering. Restart AdGuard Home on your NAS.")
                or ("DNS server " .. srv .. " isn't reachable. Check that your NAS is powered on and connected.")) }
    elseif a == "harden" then
        local done = {}
        -- 2.6.7 (user report): only put back what THIS router had (the security baseline: checks that passed here
        -- before), and never switch to key-only SSH without an SSH key (that would lock the user out of SSH).
        local base = jdec("/etc/machome/sec_baseline.json", {}); if type(base) ~= "table" then base = {} end
        local nkeys = tonumber(trim(sh("grep -c '^[^#]*ssh-' /etc/dropbear/authorized_keys"))) or 0
        if base.ssh == true and nkeys > 0 and trim(sh("uci -q get dropbear.@dropbear[0].PasswordAuth")) ~= "off" then
            os.execute("uci set dropbear.@dropbear[0].PasswordAuth=off; uci set dropbear.@dropbear[0].RootPasswordAuth=off; uci commit dropbear")
            bg("sleep 1; /etc/init.d/dropbear restart"); done[#done + 1] = "SSH key-only login"
        end
        if base.wgperm == true and not (sh("ls -l /etc/config/wireguard"):match("^%-rw%-%-%-%-%-%-%-")) then os.execute("chmod 600 /etc/config/wireguard"); done[#done + 1] = "VPN key file locked" end
        -- OpenVPN logins (2026-11-17): same rule as the WireGuard key file (GL re-creates them world-readable on save)
        local ovl = false
        if base.ovpnperm == true and (readf("/etc/config/ovpnclient") or ""):find("option password", 1, true) and not (sh("ls -l /etc/config/ovpnclient"):match("^%-rw%-%-%-%-%-%-%-")) then
            os.execute("chmod 600 /etc/config/ovpnclient"); ovl = true end
        for f in (base.ovpnperm == true and sh("ls /etc/openvpn/profiles/*/auth/* 2>/dev/null") or ""):gmatch("[^\n]+") do
            if not f:find("'", 1, true) and not (sh("ls -l '" .. f .. "'"):match("^%-rw%-%-%-%-%-%-%-")) then os.execute("chmod 600 '" .. f .. "'"); ovl = true end
        end
        if ovl then done[#done + 1] = "OpenVPN login files locked" end
        local fw = false
        for s in (base.ipsec == true and sh("uci show firewall | grep -E \"name='Allow-(IPSec-ESP|ISAKMP)'\"") or ""):gmatch("firewall%.([^%.]+)%.name") do
            if trim(sh("uci -q get firewall." .. s .. ".enabled")) ~= "0" then os.execute("uci set firewall." .. s .. ".enabled=0"); fw = true end
        end
        if fw then os.execute("uci commit firewall"); bg("/etc/init.d/firewall reload"); done[#done + 1] = "IPsec rules off" end
        -- only the services the owner chose to disable on THIS router (written by optimize.sh)
        local opt = {}
        for s in (readf("/etc/machome/optimized") or ""):gmatch("[%w_%-]+") do if s ~= "netifyd" then opt[#opt + 1] = s end end
        for _, s in ipairs(opt) do
            if os.execute("/etc/init.d/" .. s .. " enabled 2>/dev/null") == 0 then os.execute("/etc/init.d/" .. s .. " stop >/dev/null 2>&1; /etc/init.d/" .. s .. " disable >/dev/null 2>&1"); done[#done + 1] = s .. " disabled" end
        end
        if os.execute("/etc/init.d/machome enabled") ~= 0 then os.execute("/etc/init.d/machome enable"); done[#done + 1] = "sampler auto-start" end
        os.execute("/usr/sbin/machome-vpn-rps fix >/dev/null 2>&1")
        local https = base.https == true and trim(sh("uci -q get oui-httpd.main.redirect_https")) ~= "1"
        if https then done[#done + 1] = "HTTPS-only needs re-enabling on the router's Security page" end
        flog("restore hardening: " .. (#done > 0 and table.concat(done, ", ") or "nothing to change"))
        return { ok = true, changed = done, msg = #done > 0 and ("Restored: " .. table.concat(done, ", ") .. ".") or "Everything was already in place." }
    end
    return { ok = false, err = "unknown action" }
end

function M.get_usage()
