-- ---------------- Wi-Fi uplink (repeater) link quality: signal, PHY rate, retries. Read-only, fast (no scan).
-- GL's repeater.get_status has SSID/IP/DNS/MAC but no signal; MediaTek's apcli shows "unknown" in iwinfo,
-- so fall back to the driver's per-chain RSSI + last TX/RX rate ("iwpriv <dev> stat").
function M.get_uplink()
    local function run(c) local p = io.popen(c .. " 2>/dev/null"); if not p then return "" end; local s = p:read("*a") or ""; p:close(); return s end
    local dev = trim(run("ubus call network.interface.wwan status | jsonfilter -e '@.l3_device'"))
    if not dev or not dev:match("^[%w%._-]+$") then return { ok = false } end
    local out = { ok = true, dev = dev }
    local info = run("iwinfo " .. dev .. " info")
    out.signal = tonumber(info:match("Signal: (%-%d+) dBm"))
    out.noise = tonumber(info:match("Noise: (%-%d+) dBm"))
    out.rate = tonumber(info:match("Bit Rate: ([%d%.]+) MBit/s"))
    local st = run("iwpriv " .. dev .. " stat")
    local rl = st:match("Rssi:([^\n]*)")
    if rl then
        local best, n = nil, 0
        for v in rl:gmatch("%-?%d+") do v = tonumber(v); if v and v < 0 and v > -100 then n = n + 1; if not best or v > best then best = v end end end
        if not out.signal and best then out.signal = best end
        out.chains = n
    end
    local function rate(line)
        if not line then return nil end
        return { nss = tonumber(line:match("NSS(%d+)")), mcs = tonumber(line:match("MCS(%d+)")), bw = tonumber(line:match("BW(%d+)")),
                 mode = line:match("(EHT)") or line:match("(HE)") or line:match("(VHT)") or line:match("(HT)") }
    end
    out.tx = rate(st:match("Last TX Rate%s*=%s*([^\n]*)")); out.rx = rate(st:match("Last RX Rate%s*=%s*([^\n]*)"))
    out.tx_per = tonumber(st:match("Tx fail count%s*=%s*%d+, PER=([%d%.]+)%%"))
    return out
end

