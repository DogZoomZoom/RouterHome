-- Speed test (Ookla CLI), run by /etc/init.d/machome-st under procd so nginx never waits on it
local function st_running()
    local pid = trim(readf("/tmp/machome/speedtest.lock") or "")
    return pid ~= "" and readf("/proc/" .. pid .. "/cmdline") ~= nil
end

function M.start_speedtest(args)
    local mode = args and args.mode
    if mode ~= "wan" and mode ~= "vpn" and mode ~= "all" then return { ok = false, err = "invalid mode" } end
    -- VPN chooser (2026-11-17): args.iface = one tunnel to test (mode "vpn" only)
    local iface = args.iface
    if iface ~= nil and iface ~= cjson.null and iface ~= "" then
        iface = tostring(iface)
        if mode ~= "vpn" or not (iface:match("^wgclient%d+$") or iface:match("^ovpnclient%d+$")) then return { ok = false, err = "invalid tunnel" } end
    else iface = nil end
    if st_running() then return { ok = false, err = "A speed test is already running" } end
    os.execute("mkdir -p /tmp/machome")
    local f = io.open("/tmp/machome/speedtest.req", "w"); if f then f:write(iface and ("vpn:" .. iface) or mode); f:close() end
    os.remove("/tmp/machome/speedtest.cancel")
    local f2 = io.open("/tmp/machome/speedtest.json", "w")
    if f2 then f2:write(cjson.encode({ running = true, mode = mode, started = os.time(), total = 0, index = 0, results = {} })); f2:close() end
    os.execute("/etc/init.d/machome-st restart >/dev/null 2>&1")
    return { ok = true }
end

function M.cancel_speedtest()
    local f = io.open("/tmp/machome/speedtest.cancel", "w"); if f then f:write("1"); f:close() end
    os.execute("killall speedtest >/dev/null 2>&1")
    return { ok = true }
end

function M.get_speedtest()
    local function dec(p) local s = readf(p); if not s or s == "" then return nil end; local ok, v = pcall(cjson.decode, s); return ok and v or nil end
    local state = dec("/tmp/machome/speedtest.json")
    local running = st_running()
    if state and state.running and not running and state.started and os.time() - state.started > 15 then state.running = false end
    return { state = state, last = dec("/etc/machome/speedtest-last.json"), running = running or (state and state.running) or false }
end

-- Active uplink device: follows Ethernet WAN, repeater (apcli*), tethering or modem via the default route
local function active_wan()
    local p = io.popen("ip -4 route show default 2>/dev/null")
    local best, bm = nil, nil
    if p then
        for line in p:lines() do
            local dev = line:match(" dev (%S+)")
            local metric = tonumber(line:match(" metric (%d+)") or "0")
            if dev and (not bm or metric < bm) then best, bm = dev, metric end
        end
        p:close()
    end
    if best then return best end
    local q = io.popen("uci -q get network.wan.device 2>/dev/null")
    local d = q and trim(q:read("*a") or "") or ""
    if q then q:close() end
    return d ~= "" and d or "eth1"
end

function M.get_stats()
    local cool, fans = cooling()
    local freq = num("/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq")
    local maxfreq = num("/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq")
    return {
        cpu = cpu_stats(),
        temps = temps(),
        cooling = cool,
        lan_dns = lan_dns(),
        wan_dev = active_wan(),
        net_mode = (function()   -- "router" | "ap" | "wds" | "relay" | "mesh": AP mode changes which cards make sense
            local p = io.popen("uci -q get glconfig.general.mode 2>/dev/null"); local m = p and p:read("*l") or ""; if p then p:close() end
            local g = io.popen("ip -4 route show default 2>/dev/null"); local r = g and g:read("*l") or ""; if g then g:close() end
            return { mode = (m ~= "" and m or "router"), gateway = r:match("via (%d+%.%d+%.%d+%.%d+)") }
        end)(),
        dhcp = (function()  -- LAN DHCP pool use; nil when this router doesn't hand out addresses (AP mode / DHCP off)
            local p = io.popen("for k in dhcp.lan.ignore dhcp.lan.start dhcp.lan.limit network.lan.ipaddr network.lan.netmask glconfig.general.mode dhcp.@dnsmasq[0].leasefile; do echo \"$(uci -q get $k)\"; done")
            local o = {}; if p then for l in p:lines() do o[#o + 1] = l end; p:close() end
            if o[6] == "ap" or o[1] == "1" or not tonumber(o[2]) or not tonumber(o[3]) then return nil end
            local function n(ip) local a, b, c, d = tostring(ip or ""):match("^(%d+)%.(%d+)%.(%d+)%.(%d+)"); if not a then return nil end; return ((tonumber(a) * 256 + tonumber(b)) * 256 + tonumber(c)) * 256 + tonumber(d) end
            local function s(x) return string.format("%d.%d.%d.%d", math.floor(x / 16777216) % 256, math.floor(x / 65536) % 256, math.floor(x / 256) % 256, x % 256) end
            local ip, mask = n(o[4]), n(o[5])
            local cidr = tostring(o[4] or ""):match("/(%d+)$"); if not mask and cidr then mask = 4294967296 - 2 ^ (32 - tonumber(cidr)) end
            if not ip or not mask then return nil end
            local size = 4294967296 - mask; local net = ip - ip % size                       -- network address (mask is contiguous)
            local first = net + tonumber(o[2]); local last = math.min(first + tonumber(o[3]) - 1, net + size - 2)
            if last < first then return nil end
            local used, seen, now = 0, {}, os.time()
            local f = io.open((o[7] ~= "" and o[7]) or "/tmp/dhcp.leases", "r")
            if f then for l in f:lines() do
                local exp, lip = l:match("^(%d+) %S+ (%d+%.%d+%.%d+%.%d+)")
                local x = n(lip)
                if x and x >= first and x <= last and not seen[x] and (tonumber(exp) == 0 or tonumber(exp) > now) then seen[x] = true; used = used + 1 end
            end; f:close() end
            return { first = s(first), last = s(last), size = last - first + 1, used = used }
        end)(),
        tailscale = (function()  -- nil when not installed; cheap checks only (no tailscale CLI in the poll)
            local f = io.open("/usr/sbin/tailscale", "r"); if not f then return nil end; f:close()
            local p = io.popen("uci -q get tailscale.settings.enabled; uci -q get tailscale.settings.lan_enabled; ip -4 -o addr show dev tailscale0 2>/dev/null")
            local out = p and p:read("*a") or ""; if p then p:close() end
            local en, lan = out:match("^(%d)\n(%d)\n")
            return { enabled = (en == "1"), lan = (lan == "1"), up = out:find("inet 100%.") ~= nil }
        end)(),
        live = live(),
        fan_rpm = fans,
        fan = (function()   -- PWM duty + mode for the System fan dial
            local p = io.popen("ls /sys/class/hwmon/*/pwm1 2>/dev/null"); local f = p and p:read("*l"); if p then p:close() end
            if not f then return nil end
            local pwm = num(f) or 0
            local c = readf("/etc/machome/fan.json") or ""
            return { pct = math.floor(pwm * 100 / 255 + 0.5), mode = c:find('"manual"', 1, true) and "manual" or "auto",
                     failsafe = readf("/tmp/machome/fan_failsafe") ~= nil }
        end)(),
        freq_mhz = freq and math.floor(freq / 1000) or nil,
        max_freq_mhz = maxfreq and math.floor(maxfreq / 1000) or nil,
        net = net(),
        conntrack = {
            count = num("/proc/sys/net/netfilter/nf_conntrack_count"),
            max = num("/proc/sys/net/netfilter/nf_conntrack_max")
        },
        hostname = trim(readf("/proc/sys/kernel/hostname")),
        time = os.time()
    }
end

return M
