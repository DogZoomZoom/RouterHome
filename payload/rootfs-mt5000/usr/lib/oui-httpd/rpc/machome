        temp_c = (num(sysfs) or 0) / div, target_c = tonumber(uci1("glfan.globals.temperature") or "") or cjson.null,
        warn_c = tonumber(uci1("glfan.globals.warn_temperature") or "") or cjson.null,
        mode = c.mode == "manual" and "manual" or "auto", manual_pct = tonumber(c.pct) or 50,
        gl_running = pid ~= nil, failsafe = readf("/tmp/machome/fan_failsafe") ~= nil }
end
function M.get_fan() return fan_state() end

function M.set_fan(args)
    args = args or {}
    local fp = fan_paths(); if not fp then return { ok = false, err = "This router has no controllable fan" } end
    local st = fan_state()
    -- start temperature (GL's controller target), entered in °F
    if tonumber(args.target_f) then
        local c = math.floor((tonumber(args.target_f) - 32) * 5 / 9 + 0.5)
        if c < 40 or c > 85 then return { ok = false, err = "Choose a temperature between 104°F and 185°F" } end
        local warn = tonumber(st.warn_c) or 75
        if warn < c + 5 then warn = c + 5 end
        local r, e = lrpc("fan", "set_config", { temperature = c, warn_temperature = warn })
        if r == nil then return { ok = false, err = "GL's fan service refused the change" .. (e and (": " .. tostring(e.message or e)) or "") } end
    end
    if args.mode == "manual" or args.mode == "auto" then
        local pct = math.max(0, math.min(100, math.floor(tonumber(args.pct) or st.manual_pct or 50)))
        os.execute("mkdir -p /etc/machome")
        local f = io.open(FANCFG, "w"); if f then f:write(cjson.encode({ mode = args.mode, pct = pct })); f:close() end
        os.remove("/tmp/machome/fan_failsafe")
        if args.mode == "manual" then
            os.execute("/etc/init.d/gl_fan stop >/dev/null 2>&1; sleep 1; echo " .. math.floor(pct * 255 / 100 + 0.5) .. " > " .. fp.pwm)
        else
            os.execute("/etc/init.d/gl_fan start >/dev/null 2>&1")
        end
    elseif fan_state().mode == "manual" then
        os.execute("/etc/init.d/gl_fan stop >/dev/null 2>&1")   -- GL's set_config restarts its controller; stay manual
    end
    return { ok = true, fan = fan_state() }
end

-- ---------------- weather (Open-Meteo by ZIP; optional touchscreen sleep wallpaper)
local function wxmod() local ok, W = pcall(dofile, "/usr/lib/machome/weather.lua"); return ok and W or nil end
local function has_screen() local f = io.open("/etc/init.d/gl_screen", "r"); if f then f:close(); return true end; return false end

function M.get_weather()
    local W = wxmod(); if not W then return { ok = false, err = "weather module missing" } end
    local c = W.load_cfg()
    -- lat/lon rounded to city level: the page's radar window centers on it (works outside the US since 2.6.7)
    return { ok = true, zip = c.zip or "", place = c.place or "", screen_supported = has_screen(), screen = c.screen ~= false, radar = c.radar ~= false,
        dismissed = c.dismissed == true, off = c.off == true, unit = W.unit and W.unit() or "F",
        lat = c.lat and math.floor(c.lat * 10 + 0.5) / 10 or cjson.null, lon = c.lon and math.floor(c.lon * 10 + 0.5) / 10 or cjson.null,
        data = jdec(W.DATA, nil) or cjson.null }
end
--- Preferences (2.6.7): temperature unit "F" (default) or "C", for the page, Discord messages and the weather.
function M.get_prefs()
    local p = jdec("/etc/machome/prefs.json", {}); if type(p) ~= "table" then p = {} end
    return { ok = true, temp_unit = p.temp_unit == "C" and "C" or "F" }
end
function M.set_prefs(args)
    local u = type(args) == "table" and args.temp_unit
    if u ~= "C" and u ~= "F" then return { ok = false, err = "bad request" } end
    local p = jdec("/etc/machome/prefs.json", {}); if type(p) ~= "table" then p = {} end
    p.temp_unit = u
    os.execute("mkdir -p /etc/machome"); local f = io.open("/etc/machome/prefs.json", "w"); if not f then return { ok = false, err = "can't save" } end
    f:write(cjson.encode(p)); f:close()
    -- weather in the new unit right away (and a re-drawn touchscreen picture)
    local W = wxmod()
    if W then local c = W.load_cfg(); if c.lat and c.off ~= true then local d = W.fetch(c); if d then local g = io.open(W.DATA, "w"); if g then g:write(cjson.encode(d)); g:close() end end end end
    os.execute("touch /tmp/machome/wx_force")
    return { ok = true, temp_unit = u }
end

function M.set_weather(args)
    args = args or {}
    local W = wxmod(); if not W then return { ok = false, err = "weather module missing" } end
    local c = W.load_cfg()
    if args.dismiss == true then c.dismissed = true; W.save_cfg(c); return { ok = true } end
    -- weather on/off (2.6.7): off = no downloads, nothing shown, touchscreen wallpaper restored by the sampler
    if args.off ~= nil then
        c.off = args.off == true; if c.off then c.dismissed = true end
        W.save_cfg(c); os.execute("touch /tmp/machome/wx_force")
        if c.off then return { ok = true, off = true } end
    end
    if args.place ~= nil and args.zip == nil then args.zip = args.place end   -- "place": ZIP or city (same thing since 2.6.7)
    if args.screen ~= nil then c.screen = args.screen == true end
    if args.radar ~= nil then c.radar = args.radar == true; if c.radar then os.execute("touch /tmp/machome/wx_radar_now") end end
    if args.zip ~= nil then
        local g, err = W.geocode(trim(tostring(args.zip)))
        if not g then return { ok = false, err = err } end
        c.zip, c.place, c.lat, c.lon, c.dismissed, c.off = g.zip, g.place, g.lat, g.lon, nil, nil
    end
    W.save_cfg(c)
    local d = c.lat and W.fetch(c)
    if d then local f = io.open(W.DATA, "w"); if f then f:write(cjson.encode(d)); f:close() end end
    os.execute("touch /tmp/machome/wx_force")   -- sampler re-renders the sleep screen on its next tick
    if args.zip ~= nil and c.radar ~= false then os.execute("touch /tmp/machome/wx_radar_now") end   -- new place: new radar map
    return { ok = true, zip = c.zip, place = c.place, screen = c.screen ~= false, radar = c.radar ~= false, data = d or cjson.null }
end

