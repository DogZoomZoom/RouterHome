--- Security recommendations (2.6.7): "Turn on" for one check that never passed on this router. Same commands as the
--- installer's optional changes; every change writes /root/machome-backup/undo-sec-<id>.sh. HTTPS-only is done by the
--- page through GL's own local-access setting. SSH key-only needs at least one SSH key (else it would lock SSH out).
function M.sec_apply(args)
    local function sh(c) local p = io.popen(c .. " 2>/dev/null"); if not p then return "" end; local s = p:read("*a") or ""; p:close(); return s end   -- (the file's own sh/bg are defined further down)
    local function bg(c) os.execute("/bin/sh -c '" .. c .. "' </dev/null >/dev/null 2>&1 &") end
    local id = type(args) == "table" and args.id
    local B = "/root/machome-backup"; os.execute("mkdir -p " .. B)
    local undo, done = {}, nil
    if id == "ssh" then
        local n = tonumber(trim(sh("grep -c '^[^#]*ssh-' /etc/dropbear/authorized_keys"))) or 0
        if n < 1 then return { ok = false, err = "add an SSH key first (GL.inet Utilities Toolkit → SSH keys), or you'd be locked out of SSH" } end
        local pa, rpa = trim(sh("uci -q get dropbear.@dropbear[0].PasswordAuth")), trim(sh("uci -q get dropbear.@dropbear[0].RootPasswordAuth"))
        undo[#undo + 1] = "uci set dropbear.@dropbear[0].PasswordAuth='" .. (pa ~= "" and pa or "on") .. "'; uci set dropbear.@dropbear[0].RootPasswordAuth='" .. (rpa ~= "" and rpa or "on") .. "'; uci commit dropbear; /etc/init.d/dropbear restart"
        os.execute("uci set dropbear.@dropbear[0].PasswordAuth=off; uci set dropbear.@dropbear[0].RootPasswordAuth=off; uci commit dropbear")
        bg("sleep 1; /etc/init.d/dropbear restart"); done = "SSH now accepts keys only"
    elseif id == "wgperm" then
        local old = trim(sh("stat -c %a /etc/config/wireguard")); if old == "" then return { ok = false, err = "there's no VPN key file on this router" } end
        undo[#undo + 1] = "chmod " .. old .. " /etc/config/wireguard"
        os.execute("chmod 600 /etc/config/wireguard"); done = "VPN key file locked (600)"
    elseif id == "ovpnperm" then
        local files = {}
        if (readf("/etc/config/ovpnclient") or ""):find("option password", 1, true) then files[#files + 1] = "/etc/config/ovpnclient" end
        for f in sh("ls /etc/openvpn/profiles/*/auth/* 2>/dev/null"):gmatch("[^\n]+") do if not f:find("'", 1, true) then files[#files + 1] = f end end
        for _, f in ipairs(files) do local old = trim(sh("stat -c %a '" .. f .. "'")); if old ~= "" then undo[#undo + 1] = "chmod " .. old .. " '" .. f .. "'" end; os.execute("chmod 600 '" .. f .. "'") end
        done = #files .. " OpenVPN login file" .. (#files == 1 and "" or "s") .. " locked (600)"
    elseif id == "ipsec" then
        local n = 0
        for s in sh("uci show firewall | grep -E \"name='Allow-(IPSec-ESP|ISAKMP)'\""):gmatch("firewall%.([^%.]+)%.name") do
            local old = trim(sh("uci -q get firewall." .. s .. ".enabled")); undo[#undo + 1] = "uci set firewall." .. s .. ".enabled='" .. (old ~= "" and old or "1") .. "'"
            os.execute("uci set firewall." .. s .. ".enabled=0"); n = n + 1
        end
        if n == 0 then return { ok = false, err = "no IPsec firewall rules found" } end
        os.execute("uci commit firewall"); bg("/etc/init.d/firewall reload"); undo[#undo + 1] = "uci commit firewall; /etc/init.d/firewall reload"
        done = "closed " .. n .. " unused IPsec firewall opening" .. (n == 1 and "" or "s")
    else return { ok = false, err = "this one is changed in GL's own settings pages" } end
    local uf = B .. "/undo-sec-" .. id .. ".sh"
    local f = io.open(uf, "w"); if f then f:write("# undo: Security card \"Turn on\" for " .. id .. " (" .. os.date("%Y-%m-%d %H:%M") .. ")\n" .. table.concat(undo, "\n") .. "\nlogger -t machome 'undo-sec: " .. id .. " undone'\n"); f:close(); os.execute("chmod 700 " .. uf) end
    os.execute("logger -t machome 'security: " .. id .. " turned on from the Home tab (" .. done:gsub("'", "") .. ")'")
    return { ok = true, done = done, undo = uf }
end
