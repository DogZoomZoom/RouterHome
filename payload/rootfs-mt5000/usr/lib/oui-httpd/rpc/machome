--- Outage & lag log for the ISP (owner's pick 9, 2026-11-18): every outage (with its likely cause), lag episode,
--- modem restart and slow speed test of the last N days (default 30), a per-day summary and a ready-to-send text.
function M.isp_log(args)
    local days = math.max(1, math.min(31, tonumber(type(args) == "table" and args.days or nil) or 30))
    local now = os.time(); local from = now - days * 86400
    local function hm(t) return (os.date("%I:%M %p", t):gsub("^0", "")) end
    local function day(t) return (os.date("%a %b %d", t):gsub(" 0", " ")) end
    local function dur(s) s = math.floor(s or 0); if s < 90 then return s .. " s" elseif s < 5400 then return math.floor(s / 60 + 0.5) .. " min" else return string.format("%.1f h", s / 3600) end end
    local ev, tot = {}, { outages = 0, down_s = 0, lag = 0, lag_s = 0, modem = 0, slow = 0 }
    local CAUSE = { isp = "your ISP's side (the modem kept answering)", home = "the modem or its cable (the modem didn't answer either)", mixed = "the modem or the line was unstable" }
    local causes = jdec("/etc/machome/np_outages.json", {})
    for _, o in ipairs(jdec("/etc/machome/outages.json", {})) do
        if type(o) == "table" and tonumber(o.s) and tonumber(o.e) and o.e >= from then
            local cz; for _, c in ipairs(causes) do if type(c) == "table" and math.abs((tonumber(c.e) or 0) - o.e) < 300 then cz = CAUSE[c.cause] end end
            tot.outages = tot.outages + 1; tot.down_s = tot.down_s + (o.e - o.s)
            ev[#ev + 1] = { t = o.s, kind = "outage", text = "Internet down " .. dur(o.e - o.s) .. " (" .. hm(o.s) .. " – " .. hm(o.e) .. ")" .. (cz and (": likely " .. cz) or "") }
        end
    end
    for _, p in ipairs(jdec("/etc/machome/ping_log.json", {})) do
        if type(p) == "table" and tonumber(p.s) and tonumber(p.e) and p.e >= from then
            tot.lag = tot.lag + 1; tot.lag_s = tot.lag_s + (p.e - p.s)
            ev[#ev + 1] = { t = p.s, kind = "lag", text = (p.kind == "spiky" and ("Lag spikes (up to " .. tostring(p.pct or "?") .. "% of checks over the limit)") or ("High ping (up to " .. math.floor(tonumber(p.worst) or 0) .. " ms)")) ..
                " for " .. dur(p.e - p.s) .. " (" .. hm(p.s) .. " – " .. hm(p.e) .. ")" }
        end
    end
    local keep = jdec("/etc/machome/np_keep.json", {})
    for _, b in ipairs(type(keep.modem_boots) == "table" and keep.modem_boots or {}) do
        if type(b) == "table" and tonumber(b.t) and b.t >= from then tot.modem = tot.modem + 1; ev[#ev + 1] = { t = b.t, kind = "modem", text = "Cable modem restarted" .. (tonumber(b.up) and (" (it had been up " .. dur(b.up) .. ")") or "") } end
    end
    local a = jdec(ALERTS, {}); local plan = tonumber(a.plan_down) or 2000
    for _, h in ipairs(jdec("/etc/machome/speedtest-history.json", {})) do
        if type(h) == "table" and h.kind == "wan" and tonumber(h.time) and h.time >= from and tonumber(h.down) and h.down < plan * 0.7 then
            tot.slow = tot.slow + 1
            ev[#ev + 1] = { t = h.time, kind = "slow", text = "Speed test " .. math.floor(h.down) .. " / " .. math.floor(tonumber(h.up) or 0) .. " Mbps (" .. math.floor(h.down * 100 / plan) .. "% of your " .. plan .. " Mbps plan)" }
        end
    end
    table.sort(ev, function(x, y) return x.t > y.t end)
    -- per day: middle ping, lag-spike share, no-answer share, evening middle ping (7-11 PM)
    local dmap, daily = {}, {}
    for _, x in ipairs(jdec("/etc/machome/wan_hours.json", {})) do
        if type(x) == "table" and tonumber(x.h) and x.h >= from and tonumber(x.med) then
            local d = os.date("%Y-%m-%d", x.h); local hr = tonumber(os.date("%H", x.h))
            local r = dmap[d] or { d = d, t = x.h, meds = {}, eve = {}, spk = 0, loss = 0, n = 0 }
            table.insert(r.meds, x.med); if hr >= 19 and hr < 23 then table.insert(r.eve, x.med) end
            r.spk = r.spk + (tonumber(x.spk) or 0); r.loss = r.loss + (tonumber(x.loss) or 0); r.n = r.n + 1
            dmap[d] = r
        end
    end
    local function med(t) if #t == 0 then return nil end; table.sort(t); return t[math.ceil(#t / 2)] end
    for _, r in pairs(dmap) do daily[#daily + 1] = { d = r.d, t = r.t, ping = med(r.meds), eve = med(r.eve) or cjson.null, spk = math.floor(r.spk / r.n * 10 + 0.5) / 10, loss = math.floor(r.loss / r.n * 100 + 0.5) / 100, hours = r.n } end
    table.sort(daily, function(x, y) return x.t > y.t end)
    local up = 100 - tot.down_s * 100 / (days * 86400)
    local lines = { string.format("Last %d days: %d outage%s (%s down in total, %.2f%% online) · %d lag episode%s (%s) · %d modem restart%s · %d slow speed test%s.",
        days, tot.outages, tot.outages == 1 and "" or "s", dur(tot.down_s), up, tot.lag, tot.lag == 1 and "" or "s", dur(tot.lag_s), tot.modem, tot.modem == 1 and "" or "s", tot.slow, tot.slow == 1 and "" or "s") }
    if type(keep.evening) == "table" and (keep.evening.days or 0) >= 4 then
        lines[#lines + 1] = string.format("Evenings (7-11 PM): worse on %d of the last %d days (ping %s ms vs %s ms during the day).", keep.evening.slow or 0, keep.evening.days or 0, tostring(math.floor(keep.evening.eve or 0)), tostring(math.floor(keep.evening.rest or 0)))
    end
    lines[#lines + 1] = ""
    for i, e in ipairs(ev) do if i <= 60 then lines[#lines + 1] = "• " .. day(e.t) .. " " .. hm(e.t) .. " · " .. e.text end end
    if #ev > 60 then lines[#lines + 1] = "… and " .. (#ev - 60) .. " more" end
    if #ev == 0 then lines[#lines + 1] = "No outages, lag episodes, modem restarts or slow speed tests recorded in this period." end
    return { ok = true, days = days, events = ev, daily = daily, totals = tot, uptime = math.floor(up * 100 + 0.5) / 100, text = table.concat(lines, "\n"),
        since = (function() local h = jdec("/etc/machome/wan_hours.json", {}); return (h[1] and h[1].h) or cjson.null end)() }
end
