function M.vpn_log(args)
    local days = math.max(1, math.min(60, tonumber(type(args) == "table" and args.days or nil) or 30))
    local want = type(args) == "table" and type(args.provider) == "string" and args.provider ~= "" and args.provider or nil
    local now = os.time(); local from = now - days * 86400
