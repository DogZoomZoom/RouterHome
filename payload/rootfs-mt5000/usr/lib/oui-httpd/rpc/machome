                -- still open = no end, not cut short by a restart, not added from the alert history (no end recorded)
                local open = not e["end"] and not e.cut and not e.src
                local d = tonumber(e.d) or (open and (now - e.t)) or nil
                local srv = e.peer and tostring(e.peer) or nil
                local k = prov .. (srv and (" · " .. srv) or "")
                per[k] = per[k] or { n = 0, s = 0, u = 0 }; per[k].n = per[k].n + 1; per[k].s = per[k].s + (d or 0); if not d then per[k].u = per[k].u + 1 end
                local bits = { tostring(e.label or e.via or prov) .. (srv and (", server " .. srv) or "") }
                if open then bits[#bits + 1] = "DOWN NOW for " .. dur(d)
                elseif d then bits[#bits + 1] = "down " .. dur(d) .. " (" .. hm(e.t) .. " – " .. hm(e["end"]) .. ")"
                else bits[#bits + 1] = e.src and "down (length not recorded)" or "down (end not seen: the router or its checks restarted)" end
                if e.why then bits[#bits + 1] = tostring(e.why) end
                if e.moved then bits[#bits + 1] = "devices moved to " .. tostring(e.moved) .. " (still on the VPN)" end
                if (tonumber(e.heals) or 0) > 0 then bits[#bits + 1] = "auto-heal restarted it " .. e.heals .. "×" end
                if e.gaveup then bits[#bits + 1] = "auto-heal gave up" end
                ev[#ev + 1] = { t = e.t, d = d or cjson.null, open = open, provider = prov, server = srv or cjson.null, text = table.concat(bits, " · ") }
            end
        end
    end
    table.sort(ev, function(x, y) return x.t > y.t end)
    local plist = {}; for p in pairs(provs) do plist[#plist + 1] = p end; table.sort(plist)
    local sums = {}; for k, v in pairs(per) do sums[#sums + 1] = { name = k, n = v.n, s = v.s, u = v.u } end
    table.sort(sums, function(x, y) return x.n > y.n end)
    local lines = { string.format("VPN outages, last %d days%s: %d. An outage = 30 s or more with no pings AND no web page through the tunnel (or no handshake), checked by the router every 10 s with continuous pings plus an HTTPS check; my own internet connection was up at the time.",
        days, want and (" (" .. want .. ")") or "", #ev) }
    for _, x in ipairs(sums) do
        lines[#lines + 1] = string.format("- %s: %d outage%s", x.name, x.n, x.n == 1 and "" or "s") ..
            ((x.n > x.u) and (", " .. dur(x.s) .. " in total" .. (x.u > 0 and (" (" .. x.u .. " with no recorded length)") or "")) or " (lengths not recorded)")
    end
    lines[#lines + 1] = ""
    for i, e in ipairs(ev) do if i <= 60 then lines[#lines + 1] = "• " .. day(e.t) .. " " .. hm(e.t) .. " · " .. e.text end end
    if #ev > 60 then lines[#lines + 1] = "… and " .. (#ev - 60) .. " more" end
    if #ev == 0 then lines[#lines + 1] = "No VPN outages recorded in this period." end
    do local p = io.popen("uci -q get system.@system[0].zonename 2>/dev/null"); local z = p and p:read("*l") or nil; if p then p:close() end
       lines[#lines + 1] = "(Times: router's local time" .. ((z and z ~= "") and (", " .. z:gsub("[^%w/_%-]", "")) or "") .. ".)" end
    return { ok = true, days = days, provider = want or cjson.null, providers = plist, events = ev, totals = sums, text = table.concat(lines, "\n") }
end
