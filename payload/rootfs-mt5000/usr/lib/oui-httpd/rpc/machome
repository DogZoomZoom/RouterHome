--- never logins or keys. The NAS AdGuard part asks AdGuard for its DNS settings (≤6 s if the NAS is slow).
function M.dns_hub()
    local function run(c) local p = io.popen(c .. " 2>/dev/null"); if not p then return "" end; local s = p:read("*a") or ""; p:close(); return s end
    local function words(s) local t = {}; for w in (s or ""):gmatch("[^%s,]+") do t[#t + 1] = w end; return t end
    local function ns(f) local t = {}; for ip in (readf(f) or ""):gmatch("nameserver%s+(%S+)") do t[#t + 1] = ip end; return t end
    local o = { now = os.time(), mode = trim(run("uci -q get glconfig.general.mode")) }
    o.wan = { set = words(run("uci -q get network.wan.dns")), peerdns = trim(run("uci -q get network.wan.peerdns")), active = ns("/tmp/resolv.conf.d/resolv.conf.auto") }
    o.dnsmasq = { servers = words(run("uci -q get dhcp.@dnsmasq[0].server")), noresolv = trim(run("uci -q get dhcp.@dnsmasq[0].noresolv")) == "1",
        cache = tonumber(trim(run("uci -q get dhcp.@dnsmasq[0].cachesize"))) or 150, running = trim(run("pidof dnsmasq")) ~= "" }
    local opt6 = {}
    for x in run("uci -q get dhcp.lan.dhcp_option"):gmatch("%S+") do
        local v = x:match("^6,(.+)$") or x:match("^option:dns%-server,(.+)$"); if v then for ip in v:gmatch("[^,]+") do opt6[#opt6 + 1] = ip end end
    end
    o.lan = { dhcp = opt6, router = trim(run("uci -q get network.lan.ipaddr")), dhcpv6 = trim(run("uci -q get dhcp.lan.dhcpv6")), ra = trim(run("uci -q get dhcp.lan.ra")) }
    local okr, rpc = pcall(require, "oui.rpc")
    if okr then
        -- no pcall around rpc.call (it yields; see get_vpn_providers)
        local g = rpc.call("dns", "get_config", {})
        if type(g) == "table" then o.gl = { mode = g.mode, manual = g.manual_list, override_vpn = g.override_vpn, force = g.force_dns, rebind = g.rebind_protection, provider = g.provider } end
        local a = rpc.call("adguardhome", "get_config", {})
        if type(a) == "table" then o.router_adg = { enabled = a.enabled == true, dns = a.dns_enabled == true } end
        local st, tn = rpc.call("vpn-client", "get_status", {}), rpc.call("vpn-client", "get_tunnel", {})
        local pv = M.get_vpn_providers()
        local act = {}
        for _, t in ipairs(type(tn) == "table" and type(tn.tunnels) == "table" and tn.tunnels or {}) do
            local v = type(t.via) == "table" and t.via or {}; local cf = type(v.configs) == "table" and v.configs[1] or {}
            if v.via and type(cf.id_list) == "table" then act[v.via] = cf.id_list[1] end
        end
        o.vpn = {}
        for _, v in ipairs(type(st) == "table" and type(st.status_list) == "table" and st.status_list or {}) do
            if v.via then
                local pid = act[v.via] and tostring(act[v.via]):gsub("%D", "") or nil
                o.vpn[#o.vpn + 1] = { via = v.via, name = v.name, enabled = v.enabled == true, status = v.status, server = v.peer_name,
                    provider = (pv.groups or {})[tostring(v.group_id or "")], type = v.type,
                    -- WireGuard: the DNS saved with the server. OpenVPN: the server pushes it on connect (shown via resolv)
                    dns = (pid and v.type ~= "openvpn") and words(run("uci -q get wireguard.peer_" .. pid .. ".dns")) or {},
                    resolv = ns("/tmp/resolv.conf.d/resolv.conf." .. v.via) }
            end
        end
    end
    local P = more()
    if type(P) == "table" and P.adg_cfg then
        local c = P.adg_cfg()
        if type(c.url) == "string" and c.url ~= "" then
            o.nas_adg = { host = c.url:match("^https?://([^/:%]]+)") or "", dns = P.adg_dns and P.adg_dns() or nil }
        end
    end
    local lv = jdec("/tmp/machome/live.json", {})
    o.live = { dns = lv.dns, dh = lv.dh }
    local w = jdec("/tmp/machome/dnswho.json", nil)
    if type(w) == "table" then o.who = { names = w.names, ispleak = w.ispleak == true, t = w.t } end
    local h = jdec("/tmp/machome/dnswatch.json", {})
    o.whohist = {}; if type(h) == "table" then for i = math.max(1, #h - 47), #h do if h[i] then o.whohist[#o.whohist + 1] = { t = h[i].t, n = h[i].n } end end end
    return o
end
--- DNS Race: one lookup of a domain at every resolver at once, in the background (≈2 s); poll dns_race_result.
function M.dns_race(args)
    local d = type(args) == "table" and tostring(args.domain or "") or ""
    d = d:lower():gsub("^%s+", ""):gsub("%s+$", ""):gsub("^https?://", ""):gsub("/.*$", "")
    if d == "" then d = "example.com" end
    if #d > 100 or not d:match("^[%w][%w%-%.]*%.[%a][%w%-]*$") then return { ok = false, err = "that doesn't look like a domain name (e.g. example.com)" } end
    local lock = tonumber(trim(readf("/tmp/machome/dnsrace.lock") or ""))
    if lock and os.time() - lock < 15 then return { ok = false, err = "a race is already running" } end
    local f = io.open("/tmp/machome/dnsrace.lock", "w"); if f then f:write(tostring(os.time())); f:close() end
    os.execute("(lua /usr/lib/machome/dns_race.lua '" .. d .. "'; rm -f /tmp/machome/dnsrace.lock) >/dev/null 2>&1 &")
    return { ok = true, domain = d, started = os.time() }
end
