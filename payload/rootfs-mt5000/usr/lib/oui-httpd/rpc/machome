-- machome: read-only status provider for the macOS-style Home tab.
-- Installed at /usr/lib/oui-httpd/rpc/machome  (called as "machome"."get_stats")

local M = {}
local cjson = require "cjson"

local function readf(p)
    local f = io.open(p, "r")
    if not f then return nil end
    local s = f:read("*a")
    f:close()
    return s
end

local function num(p)
    local s = readf(p)
    if not s then return nil end
    return tonumber((s:gsub("%s", "")))
end

local function trim(s)
    return s and (s:gsub("^%s+", ""):gsub("%s+$", "")) or nil
end

local function parse_stat()
    local t = {}
    for line in (readf("/proc/stat") or ""):gmatch("[^\n]+") do
        local name, rest = line:match("^(cpu%d*)%s+(.*)$")
        if name then
            local n = {}
            for v in rest:gmatch("%d+") do n[#n + 1] = tonumber(v) end
            local total = 0
            for i = 1, math.min(#n, 8) do total = total + n[i] end
            t[name] = { idle = (n[4] or 0) + (n[5] or 0), total = total }
        end
    end
    return t
end

local PREV = "/tmp/machome_cpu"

local function load_prev()
    local s = readf(PREV)
    if not s then return nil end
    local ts = tonumber(s:match("^ts (%d+)"))
    if not ts or os.time() - ts > 30 then return nil end
    local t = {}
    for name, idle, total in s:gmatch("(cpu%d*) (%d+) (%d+)") do
        t[name] = { idle = tonumber(idle), total = tonumber(total) }
    end
    return t
end

local function save_prev(t)
    local f = io.open(PREV, "w")
    if not f then return end
    f:write("ts ", os.time(), "\n")
    for k, v in pairs(t) do
        f:write(k, " ", string.format("%d", v.idle), " ", string.format("%d", v.total), "\n")
    end
    f:close()
end

local function usage(c, p)
    if not c or not p then return nil end
    local dt = c.total - p.total
    if dt <= 0 then return nil end
    local u = 100 * (1 - (c.idle - p.idle) / dt)
    if u < 0 then u = 0 elseif u > 100 then u = 100 end
    return math.floor(u * 10 + 0.5) / 10
end

local function cpu_stats()
    local cur = parse_stat()
    local prev = load_prev()
    if not prev or not prev.cpu or not cur.cpu or (cur.cpu.total - prev.cpu.total) < 20 then
        prev = cur
        os.execute("sleep 1")
        cur = parse_stat()
    end
    save_prev(cur)

    local cores = {}
    for i = 0, 63 do
        local k = "cpu" .. i
        if not cur[k] then break end
        cores[#cores + 1] = usage(cur[k], prev[k]) or 0
    end

    return { usage = usage(cur.cpu, prev.cpu) or 0, cores = cores }
end

local function temps()
    local list = {}
    for i = 0, 15 do
        local base = "/sys/class/thermal/thermal_zone" .. i
        local t = num(base .. "/temp")
        if not t then break end
        list[#list + 1] = { name = trim(readf(base .. "/type")) or ("zone" .. i), temp = t / 1000 }
    end
    return list
end

local function net()
    local out = {}
    local p = io.popen("ls /sys/class/net 2>/dev/null")
    if not p then return out end
    for ifname in p:lines() do
        if ifname:match("^eth%d") or ifname:match("^br%-lan$") or ifname:match("^wgclient") or
           ifname:match("^ovpnclient") or ifname:match("^wgserver") or ifname:match("^tailscale") or
           ifname:match("^usb") or ifname:match("^wwan") or ifname:match("^rmnet") then
            local base = "/sys/class/net/" .. ifname
            out[ifname] = {
                rx = num(base .. "/statistics/rx_bytes") or 0,
                tx = num(base .. "/statistics/tx_bytes") or 0,
                state = trim(readf(base .. "/operstate")) or "unknown",
                speed = num(base .. "/speed")
            }
        end
    end
    p:close()
    return out
end

local function cooling()
    local list = {}
    for i = 0, 15 do
        local base = "/sys/class/thermal/cooling_device" .. i
        local cur = num(base .. "/cur_state")
        if cur == nil then break end
        list[#list + 1] = { type = trim(readf(base .. "/type")) or ("cooling" .. i), cur = cur, max = num(base .. "/max_state") or 0 }
    end
    local fans = {}
    local p = io.popen("ls /sys/class/hwmon/*/fan*_input 2>/dev/null")
    if p then
        for f in p:lines() do fans[#fans + 1] = num(f) end
        p:close()
    end
    return list, fans
end

-- DNS servers handed to LAN clients via DHCP option 6 (e.g. a local Pi-hole / DNS box)
local function lan_dns()
    local ok, uci = pcall(require, "uci")
    if not ok then return {} end
    local c = uci.cursor()
    local opts = c:get("dhcp", "lan", "dhcp_option") or {}
    if type(opts) == "string" then opts = { opts } end
    local out = {}
    for _, o in ipairs(opts) do
        local code, rest = o:match("^%s*([%w:%-]+)%s*,(.*)$")
        if code == "6" or code == "option:dns-server" then
            for ip in rest:gmatch("[^,%s]+") do out[#out + 1] = ip end
        end
    end
    return out
end

-- Data written by the background sampler (/usr/bin/machome-sampler)
local function live()
    local s = readf("/tmp/machome/live.json")
    if not s or s == "" then return nil end
    local ok, v = pcall(cjson.decode, s)
    return ok and v or nil
end

-- 24 h history, downsampled to 5-minute buckets: temp (C max), down/up (bytes/s)
function M.get_history()
    local rows = {}
    for line in (readf("/tmp/machome/hist") or ""):gmatch("[^\n]+") do
        local ts, t, rx, tx = line:match("^(%d+) ([%d%.%-]+) (%d+) (%d+)")
        if ts then rows[#rows + 1] = { tonumber(ts), tonumber(t), tonumber(rx), tonumber(tx) } end
    end
    local out = { t = {}, temp = {}, down = {}, up = {}, step = 300, count = #rows }
    local B, bucket, acc = 300, nil, nil
    local function flush()
        if acc and acc.n > 0 then
            out.t[#out.t + 1] = bucket
            out.temp[#out.temp + 1] = math.floor(acc.temp / acc.n * 10 + 0.5) / 10
            out.down[#out.down + 1] = acc.dt > 0 and math.floor(acc.rx / acc.dt) or 0
            out.up[#out.up + 1] = acc.dt > 0 and math.floor(acc.tx / acc.dt) or 0
        end
    end
    for i = 1, #rows do
        local r = rows[i]
        local b = r[1] - r[1] % B
        if b ~= bucket then flush(); bucket = b; acc = { temp = 0, n = 0, rx = 0, tx = 0, dt = 0 } end
        acc.temp = acc.temp + r[2]; acc.n = acc.n + 1
        local p = rows[i - 1]
        if p then
            local dt, drx, dtx = r[1] - p[1], r[3] - p[3], r[4] - p[4]
            if dt > 0 and dt < 600 and drx >= 0 and dtx >= 0 then
                acc.rx = acc.rx + drx; acc.tx = acc.tx + dtx; acc.dt = acc.dt + dt
            end
        end
    end
    flush()
    out.first = rows[1] and rows[1][1] or nil
    return out
end

-- Full settings backup (standard OpenWrt sysupgrade -b), fetched via /download then deleted
function M.make_backup()
    os.execute("mkdir -p /tmp/machome && rm -f /tmp/machome/backup.tgz && /sbin/sysupgrade -b /tmp/machome/backup.tgz >/dev/null 2>&1")
    local f = io.open("/tmp/machome/backup.tgz", "r")
    if not f then return { ok = false } end
    local size = f:seek("end"); f:close()
    return { ok = true, path = "/tmp/machome/backup.tgz", size = size }
end

-- VPN provider names per config group (names only; no credentials leave the router)
local KNOWN = {
    { "surfshark", "Surfshark" }, { "windscribe", "Windscribe" }, { "whiskergalaxy", "Windscribe" },
    { "mullvad", "Mullvad" }, { "nordvpn", "NordVPN" }, { "protonvpn", "Proton VPN" }, { "proton", "Proton VPN" },
    { "ipvanish", "IPVanish" }, { "azirevpn", "AzireVPN" }, { "hide.me", "hide.me" }, { "hideme", "hide.me" },
    { "purevpn", "PureVPN" }, { "privateinternetaccess", "PIA" }, { "pia", "PIA" }, { "expressvpn", "ExpressVPN" },
    { "cyberghost", "CyberGhost" }, { "ivpn", "IVPN" }, { "airvpn", "AirVPN" }
}
local function canon(name, domain)
    local n, d = (name or ""):lower(), (domain or ""):lower()
    for _, k in ipairs(KNOWN) do if n:find(k[1], 1, true) then return k[2] end end
    for _, k in ipairs(KNOWN) do if d:find(k[1], 1, true) then return k[2] end end
    if d:match("^%a%a%-%a%a%a%-wg%-%d+") then return "Mullvad" end
    return (name and name ~= "" and name ~= "FromApp") and name or nil
end

function M.get_vpn_providers()
    local out, servers = {}, {}
    local ok, rpc = pcall(require, "oui.rpc")
    if not ok then return { groups = out, servers = servers } end
    -- no pcall here: the call yields (ngx cosocket) and LuaJIT pcall can't cross that boundary
    local r = rpc.call("vpn-client", "get_all_config_list", {})
    if type(r) == "table" and type(r.configs) == "table" then
        for _, kind in ipairs({ "wireguard", "openvpn" }) do
            for _, g in ipairs(r.configs[kind] or {}) do
                local p = g.peers and g.peers[1] or (g.clients and g.clients[1]) or {}
                local nm = canon(g.group_name, p.end_point or p.name or p.server or "")
                if nm and g.group_id then out[tostring(g.group_id)] = nm end
                -- VPN card server picker (2026-11-15): saved servers, names and locations ONLY (never keys, logins or certs).
                -- OpenVPN servers since 2026-11-17 (GL calls them clients; client_id goes in peer_id, kind tells them apart:
                -- WireGuard and OpenVPN ids can be the same number).
                if g.group_id then
                    for _, pe in ipairs((kind == "wireguard" and g.peers or g.clients) or {}) do
                        local id = kind == "wireguard" and pe.peer_id or pe.client_id
                        if id then
                            servers[#servers + 1] = { kind = kind, group_id = g.group_id, peer_id = id, name = tostring(pe.name or ("Server " .. id)),
                                location = type(pe.location) == "string" and pe.location or "", provider = nm or tostring(g.group_name or "VPN") }
                        end
                    end
                end
            end
        end
    end
    return { groups = out, servers = servers }
end

-- ---------------- Discord alerts settings (webhook never returned to the page in full)
local ALERTS = "/etc/machome/alerts.json"
local WH_PAT = "^https://[%w%.]*discord[%w]*%.com/api/webhooks/%d+/[%w_%-]+$"
local ALERT_TYPES = { "vpn", "dns", "wan", "newdev", "security", "temp", "firmware", "upgrade", "speed", "login", "weekly", "backup", "health", "config", "isp", "wifi", "schedule", "presence", "data", "upload", "devwatch", "monthly", "ping", "adspike", "rhupdate", "vuln" }

-- event timeline (written by extras.lua for every alert): newest first, last 100
function M.get_events()
    local ok, v = pcall(cjson.decode, readf("/tmp/machome/events.json") or "[]")
    local list = {}
    if ok and type(v) == "table" then for i = #v, math.max(1, #v - 99), -1 do list[#list + 1] = v[i] end end
    return { list = list, n = #list, total = (ok and type(v) == "table") and #v or 0, now = os.time() }
end
-- clear the event timeline (Recent events window): range "hour" | "day" | "week" removes the events from that
-- period (the newest ones), "all" removes everything. Cleans the RAM copy and the copy kept for reboots, and tells
-- the sampler (which keeps the list in memory) through /tmp/machome/events_clear.
function M.clear_events(args)
    local secs = ({ hour = 3600, day = 86400, week = 7 * 86400, all = 0 })[type(args) == "table" and args.range or ""]
    if not secs then return { ok = false, err = "unknown range" } end
    local since = secs == 0 and 0 or (os.time() - secs)
    -- 2026-11-18: optional kinds = { "vpn", "ping", ... }: only events of those kinds
    local kinds = nil
    if type(args.kinds) == "table" and #args.kinds > 0 then
        kinds = {}; for _, k in ipairs(args.kinds) do if type(k) == "string" and k:match("^[%w_]+$") then kinds[k] = true end end
        if not next(kinds) then return { ok = false, err = "bad kinds" } end
    end
    local function filt(p)
        local ok, v = pcall(cjson.decode, readf(p) or "[]"); if not ok or type(v) ~= "table" then return 0 end
        local keep, n = {}, 0
        for _, e in ipairs(v) do if type(e) == "table" and ((tonumber(e.t) or 0) < since or (kinds and not kinds[tostring(e.k)])) then keep[#keep + 1] = e else n = n + 1 end end
        local f = io.open(p .. ".tmp", "w"); if f then f:write(#keep > 0 and cjson.encode(keep) or "[]"); f:close(); os.rename(p .. ".tmp", p) end
        return n
    end
    local kl = {}; for k in pairs(kinds or {}) do kl[#kl + 1] = k end
    local f = io.open("/tmp/machome/events_clear", "w"); if f then f:write(kinds and cjson.encode({ since = since, kinds = kl }) or tostring(since)); f:close() end
    local n = filt("/tmp/machome/events.json")
    if readf("/etc/machome/save/events.json") then filt("/etc/machome/save/events.json") end
    return { ok = true, removed = n }
end
local function jdec(p, def) local s = readf(p); if not s or s == "" then return def end; local ok, v = pcall(cjson.decode, s); return (ok and type(v) == "table") and v or def end

function M.get_alerts()
    local c = jdec(ALERTS, {})
    local wh = c.webhook or ""
    local types = {}
    for _, k in ipairs(ALERT_TYPES) do types[k] = not (type(c.types) == "table" and c.types[k] == false) end
    return { enabled = c.enabled == true, has_webhook = wh ~= "", hint = (wh ~= "") and ("…" .. wh:sub(-6)) or "",
        types = types, temp_f = tonumber(c.temp_f) or 185, ping_ms = tonumber(c.ping_ms) or 75,speed_daily = c.speed_daily ~= false, speed_hour = tonumber(c.speed_hour) or 3,
        autoheal = c.autoheal ~= false, failover = c.failover ~= false, autoreboot = c.autoreboot ~= false, wifi_report = c.wifi_report ~= false, weekly_day = tonumber(c.weekly_day) or 0, weekly_hour = tonumber(c.weekly_hour) or 9,
        wan_heal = c.wan_heal ~= false, dns_heal = c.dns_heal ~= false, ts_heal = c.ts_heal ~= false,
        wifi_heal = c.wifi_heal ~= false, vpn_switch = c.vpn_switch == true, speed_retest = c.speed_retest ~= false,
        nas_retry = c.nas_retry ~= false, nas_wake = c.nas_wake ~= false, leak_fix = c.leak_fix ~= false, ct_relief = c.ct_relief ~= false,
        storage_trim = c.storage_trim ~= false, ap_uplink = c.ap_uplink ~= false,
        svc_autostop = c.svc_autostop == true, chan_auto = c.chan_auto == true, modem_restart = c.modem_restart == true,
        -- 2026-11-18
        sqm_auto = c.sqm_auto == true, stuck_fix = c.stuck_fix ~= false, mem_fix = c.mem_fix ~= false, vpn_keep_provider = c.vpn_keep_provider ~= false, vpn_autoforget = c.vpn_autoforget ~= false,
        adg_watch = c.adg_watch == true, vpn_return = c.vpn_return ~= false,
        ev_keep_days = tonumber(c.ev_keep_days) or 14, digest_hour = tonumber(c.digest_hour) or 18,
        digest_types = type(c.digest_types) == "table" and c.digest_types or {}, mutes = (function()
            local m = {}; for k, u in pairs(type(c.mutes) == "table" and c.mutes or {}) do if tonumber(u) and tonumber(u) > os.time() then m[k] = tonumber(u) end end
            return next(m) and m or cjson.empty_object or {} end)() }
end

function M.set_alerts(args)
    args = args or {}
    local c = jdec(ALERTS, {})
    if type(args.webhook) == "string" and args.webhook ~= "" then
        local w = trim(args.webhook)
        if not w:match(WH_PAT) then return { ok = false, err = "That doesn't look like a Discord webhook URL (https://discord.com/api/webhooks/…)" } end
        c.webhook = w
    end
    if args.clear_webhook == true then c.webhook = "" end
    if args.enabled ~= nil then c.enabled = args.enabled == true end
    if type(args.types) == "table" then
        c.types = type(c.types) == "table" and c.types or {}
        for _, k in ipairs(ALERT_TYPES) do if args.types[k] ~= nil then c.types[k] = args.types[k] == true end end
    end
    if tonumber(args.temp_f) then c.temp_f = math.max(120, math.min(220, math.floor(tonumber(args.temp_f)))) end
    if tonumber(args.ping_ms) then c.ping_ms = math.max(20, math.min(1000, math.floor(tonumber(args.ping_ms)))) end   -- high WAN ping alert limit (2026-11-17)
    if args.speed_daily ~= nil then c.speed_daily = args.speed_daily == true end
    if tonumber(args.speed_hour) then c.speed_hour = math.max(0, math.min(23, math.floor(tonumber(args.speed_hour)))) end
    if args.autoheal ~= nil then c.autoheal = args.autoheal == true end
    if args.failover ~= nil then c.failover = args.failover == true end
    if args.autoreboot ~= nil then c.autoreboot = args.autoreboot == true end
    if args.wifi_report ~= nil then c.wifi_report = args.wifi_report == true end
    for _, k in ipairs({ "wan_heal", "dns_heal", "ts_heal", "wifi_heal", "vpn_switch", "speed_retest",
                         "nas_retry", "nas_wake", "leak_fix", "ct_relief", "storage_trim", "ap_uplink", "svc_autostop", "chan_auto", "modem_restart",
                         "sqm_auto", "stuck_fix", "mem_fix", "vpn_keep_provider", "vpn_autoforget", "adg_watch", "vpn_return" }) do if args[k] ~= nil then c[k] = args[k] == true end end
    -- 2026-11-18: how long Recent events are kept, and the daily digest
    if tonumber(args.ev_keep_days) then c.ev_keep_days = math.max(1, math.min(30, math.floor(tonumber(args.ev_keep_days)))) end
    if tonumber(args.digest_hour) then c.digest_hour = math.max(0, math.min(23, math.floor(tonumber(args.digest_hour)))) end
    if type(args.digest_types) == "table" then
        local ok = {}; for _, k in ipairs(ALERT_TYPES) do ok[k] = true end
        local list = {}; for _, k in ipairs(args.digest_types) do if ok[k] then list[#list + 1] = k end end
        c.digest_types = list
    end
    if tonumber(args.weekly_day) then c.weekly_day = math.max(0, math.min(6, math.floor(tonumber(args.weekly_day)))) end
    if tonumber(args.weekly_hour) then c.weekly_hour = math.max(0, math.min(23, math.floor(tonumber(args.weekly_hour)))) end
    if tonumber(args.plan_down) then c.plan_down = math.max(1, math.min(100000, tonumber(args.plan_down))) end
    if tonumber(args.plan_up) then c.plan_up = math.max(1, math.min(100000, tonumber(args.plan_up))) end
    os.execute("mkdir -p /etc/machome")
    local f = io.open(ALERTS .. ".tmp", "w"); if not f then return { ok = false, err = "could not save" } end
    f:write(cjson.encode(c)); f:close()
    os.execute("chmod 600 " .. ALERTS .. ".tmp; mv " .. ALERTS .. ".tmp " .. ALERTS)
    return { ok = true }
end

function M.test_alert()
    local c = jdec(ALERTS, {})
    local w = c.webhook or ""
    if not w:match(WH_PAT) then return { ok = false, err = "No webhook saved yet" } end
    local host = trim(readf("/proc/sys/kernel/hostname") or "Router")
    local body = cjson.encode({ username = host .. " router", embeds = { {
        title = "✅ Test alert from your " .. host, color = 3446617,
        description = "Discord alerts are working. You'll be notified about VPN, DNS and internet problems, new devices, security changes, temperature, firmware updates and nightly speed tests.",
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ") } } })
    local f = io.open("/tmp/machome/wh_test.json", "w"); if not f then return { ok = false, err = "tmp write failed" } end
    f:write(body); f:close()
    local p = io.popen("curl -s -m 12 -o /dev/null -w '%{http_code}' -H 'Content-Type: application/json' --data-binary @/tmp/machome/wh_test.json '" .. w .. "' 2>/dev/null")
    local code = p and trim(p:read("*a") or "") or ""
    if p then p:close() end
    os.remove("/tmp/machome/wh_test.json")
    return { ok = code == "204" or code == "200", code = code }
end

-- ---------------- NAS backup, AdGuard on the NAS, device pause, ISP report, hardware acceleration
local function more() return dofile("/usr/lib/machome/more.lua") end
local function lrpc(obj, method, params)
    local P = more()
    P.writef("/tmp/machome/lrpc_m.json", cjson.encode({ jsonrpc = "2.0", id = 1, method = "call", params = { "", obj, method, params or {} } }))
    local p = io.popen("curl -s -m 20 -H 'glinet: 1' -H 'Content-Type: application/json' --data-binary @/tmp/machome/lrpc_m.json http://127.0.0.1/rpc 2>/dev/null")
    local out = p and p:read("*a") or ""; if p then p:close() end
    local ok, v = pcall(cjson.decode, out)
    if ok and type(v) == "table" then if v.error then return nil, v.error end; return v.result end
end

function M.get_nas_backup()
    local r = more().nas_public()
    r.running = readf("/tmp/machome/nas_running") ~= nil
    r.verifying = readf("/tmp/machome/nas_verifying") ~= nil
    return r
end
-- VPN leak test (background, ~30 s): run + read the result
function M.run_leaktest()
    if readf("/tmp/machome/leak_running") then return { ok = true, msg = "Already running" } end
    os.execute("mkdir -p /tmp/machome; echo 1 > /tmp/machome/leak_running; (lua -e 'local P=dofile(\"/usr/lib/machome/more.lua\"); P.leak_test()' >/dev/null 2>&1; rm -f /tmp/machome/leak_running) &")
    return { ok = true }
end
function M.get_leaktest()
    local ok, v = pcall(cjson.decode, readf("/tmp/machome/leaktest.json") or "null")
    local okw, w = pcall(cjson.decode, readf("/tmp/machome/dnswatch.json") or "[]")
    return { running = readf("/tmp/machome/leak_running") ~= nil, result = (ok and type(v) == "table") and v or cjson.null,
             watch = (okw and type(w) == "table") and w or {} }
end
